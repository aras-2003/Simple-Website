{
  "name": "arkadiuszkamrowski",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "arkadiuszkamrowski.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/*/"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "DEPLOYMENT_ENV": "production",
    "CONTACT_REQUIRE_ORIGIN": "1",
    "CONTACT_ALLOWED_ORIGINS": "https://arkadiuszkamrowski.com",
    "TURNSTILE_REQUIRED": "1",
    "TURNSTILE_EXPECTED_HOSTNAME": "arkadiuszkamrowski.com",
    "CONTACT_FROM_EMAIL": "Website <contact@arkadiuszkamrowski.com>",
    "PRODUCT_MEASUREMENT": "1"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "42017",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "MEASUREMENT_RATE_LIMITER",
      "namespace_id": "42019",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
