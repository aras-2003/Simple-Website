# Production environment contract — copy to your secret/config store, not to a committed .env.production file.
SITE_BASE_URL=https://arkadiuszkamrowski.com
SITE_PRODUCTION_HOST=arkadiuszkamrowski.com
REQUIRE_PRODUCTION_SITE=1
HOST=arkadiuszkamrowski.com
NAMESPACE=personal-site

# Set to commit-addressable/immutable registry tags when building production images.
IMAGE=
CONTACT_IMAGE=

# Public Cloudflare Turnstile sitekey. This is intentionally browser-visible.
PUBLIC_TURNSTILE_SITE_KEY=

# Contact API runtime
CONTACT_DRY_RUN=0
CONTACT_API_PORT=8787
CONTACT_RATE_LIMIT=5
CONTACT_RATE_BUCKETS=5000
CONTACT_REQUIRE_ORIGIN=1
CONTACT_ALLOWED_ORIGINS=https://arkadiuszkamrowski.com
TURNSTILE_REQUIRED=1
TURNSTILE_EXPECTED_HOSTNAME=arkadiuszkamrowski.com

# Secrets / private values — configure in the hosting platform secret store.
# Never commit real values.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Website <contact@arkadiuszkamrowski.com>"
