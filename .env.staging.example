# Staging environment contract — copy values to Cloudflare staging build/runtime settings.
SITE_BASE_URL=https://staging.arkadiuszkamrowski.com
SITE_PRODUCTION_HOST=staging.arkadiuszkamrowski.com
REQUIRE_PRODUCTION_SITE=1
NODE_VERSION=22.23.2

# Public staging Turnstile sitekey. Use a dedicated staging widget.
PUBLIC_TURNSTILE_SITE_KEY=

# Non-secret staging Worker runtime values are committed in wrangler.staging.jsonc.
# Secrets below belong only in the staging Worker secret store.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Expected committed runtime contract:
# DEPLOYMENT_ENV=staging
# CONTACT_REQUIRE_ORIGIN=1
# CONTACT_ALLOWED_ORIGINS=https://staging.arkadiuszkamrowski.com
# TURNSTILE_REQUIRED=1
# TURNSTILE_EXPECTED_HOSTNAME=staging.arkadiuszkamrowski.com
# CONTACT_FROM_EMAIL="Website Staging <contact@arkadiuszkamrowski.com>"
