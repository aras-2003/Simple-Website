PORT=8080
SITE_BASE_URL=http://localhost:8080
NAMESPACE=personal-site-local
IMAGE=arkadiusz-kamrowski-site:local
CONTACT_IMAGE=arkadiusz-kamrowski-contact:local

# Contact API. Dry-run is safe for local setup and CI.
CONTACT_DRY_RUN=1
CONTACT_API_PORT=8787
CONTACT_RATE_LIMIT=5
CONTACT_RATE_BUCKETS=5000
CONTACT_REQUIRE_ORIGIN=0
CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Turnstile is optional in local dry-run. Production requires real keys.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_REQUIRED=0
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_SECRET_KEY=

# Set these only in local .env / deployment secrets. Never commit real values.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
