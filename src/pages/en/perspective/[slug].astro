---
import NotePage from '../../../components/NotePage.astro';
import { getWriting, writingSlug } from '../../../content/writing';

export async function getStaticPaths() {
  const notes = await getWriting('en');
  return notes.map((note) => ({ params: { slug: writingSlug(note) }, props: { note } }));
}
const { note } = Astro.props;
---
<NotePage locale="en" note={note} />
