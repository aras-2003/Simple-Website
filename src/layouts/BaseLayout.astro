---
import '../styles/global.css';
import '../styles/responsive.css';
import '../styles/content-ia.css';
import '../styles/quality-hardening.css';
import '../styles/studio-polish.css';
import '../styles/vnext.css';
import '../styles/editorial-platform.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, route, type Locale, type RouteKey } from '../lib/site';
import { copy } from '../i18n/content';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  paths?: { pl: string; en: string };
}

const { locale, routeKey, title, description, paths } = Astro.props;
const c = copy[locale];
const canonicalPath = paths?.[locale] ?? route(locale, routeKey);
const plPath = paths?.pl ?? route('pl', routeKey);
const enPath = paths?.en ?? route('en', routeKey);
const canonical = absoluteUrl(canonicalPath, Astro.site);
const plUrl = absoluteUrl(plPath, Astro.site);
const enUrl = absoluteUrl(enPath, Astro.site);
const ogLocale = locale === 'pl' ? 'pl_PL' : 'en_US';
const personId = `${absoluteUrl('/o-mnie', Astro.site)}#person`;
const websiteId = `${absoluteUrl('/', Astro.site)}#website`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Arkadiusz Kamrowski',
  url: absoluteUrl(route('pl', 'about'), Astro.site),
  sameAs: ['https://pl.linkedin.com/in/arkadiusz-kamrowski'],
  knowsAbout: ['Organizational Architecture', 'Enterprise Architecture', 'Strategy', 'Transformation', 'PMO', 'Portfolio Management', 'Technology', 'AI Governance'],
  ...(routeKey === 'about' ? {
    jobTitle: locale === 'pl' ? 'Dyrektor Departamentu Architektury Korporacyjnej, Strategii i PMO' : 'Director of Enterprise Architecture, Strategy & PMO',
  } : {}),
};
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Arkadiusz Kamrowski',
      url: absoluteUrl('/', Astro.site),
      inLanguage: ['pl', 'en'],
      author: { '@id': personId },
      description: locale === 'pl'
        ? 'Platforma o architekturze organizacyjnej, architekturze korporacyjnej, strategii, portfelu, transformacji i systemach decyzji.'
        : 'A platform on organizational architecture, enterprise architecture, strategy, portfolio, transformation and decision systems.',
    },
    person,
  ],
});
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eee9df" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={plUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={absoluteUrl('/assets/og-card.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{c.skipMain}</a>
    <div class="page-grid" aria-hidden="true"></div>
    <Header locale={locale} current={routeKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
