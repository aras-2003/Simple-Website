---
import '../styles/global.css';
import '../styles/responsive.css';
import '../styles/content-ia.css';
import '../styles/quality-hardening.css';
import '../styles/studio-polish.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, route, type Locale, type RouteKey } from '../lib/site';
import { copy } from '../i18n/content';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  paths?: { pl: string; en: string };
}

const { locale, routeKey, title, description, paths } = Astro.props;
const c = copy[locale];
const canonicalPath = paths?.[locale] ?? route(locale, routeKey);
const plPath = paths?.pl ?? route('pl', routeKey);
const enPath = paths?.en ?? route('en', routeKey);
const canonical = absoluteUrl(canonicalPath, Astro.site);
const plUrl = absoluteUrl(plPath, Astro.site);
const enUrl = absoluteUrl(enPath, Astro.site);
const ogLocale = locale === 'pl' ? 'pl_PL' : 'en_US';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Arkadiusz Kamrowski',
  url: absoluteUrl('/', Astro.site),
  image: absoluteUrl('/assets/arkadiusz-kamrowski.svg', Astro.site),
  sameAs: ['https://pl.linkedin.com/in/arkadiusz-kamrowski'],
  jobTitle: locale === 'pl' ? 'Dyrektor Departamentu Architektury Korporacyjnej, Strategii i PMO' : 'Director of Enterprise Architecture, Strategy & PMO',
  knowsAbout: ['Enterprise Architecture', 'Strategy', 'Transformation', 'PMO', 'Technology', 'AI Governance'],
});
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1eadf" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={plUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={absoluteUrl('/assets/og-card.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{c.skipMain}</a>
    <div class="page-grid" aria-hidden="true"></div>
    <Header locale={locale} current={routeKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
