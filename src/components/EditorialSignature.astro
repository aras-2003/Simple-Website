---
interface Props {
  slug: string;
  inverse?: boolean;
}
const { slug, inverse = false } = Astro.props;
---
<div class:list={["editorial-signature", inverse && "editorial-signature--inverse"]} aria-hidden="true">
  {slug === 'portfolio-as-strategy-in-motion' && (
    <svg viewBox="0 0 180 96" role="img">
      <path d="M90 8v24M90 32H30v20M90 32v20M90 32h60v20" />
      <path d="M22 52h16M82 52h16M142 52h16" />
      <path d="M30 68v18M90 68v18M150 68v18" />
      <circle cx="90" cy="8" r="4" />
      <circle cx="30" cy="86" r="4" />
      <circle cx="90" cy="86" r="4" />
      <circle cx="150" cy="86" r="4" />
    </svg>
  )}
  {slug === 'architecture-as-decision-system' && (
    <svg viewBox="0 0 180 96" role="img">
      <path d="M14 74H166" />
      <path d="M28 74V58M68 74V44M108 74V30M148 74V16" />
      <circle cx="28" cy="58" r="4" />
      <circle cx="68" cy="44" r="4" />
      <circle cx="108" cy="30" r="4" />
      <circle cx="148" cy="16" r="4" />
    </svg>
  )}
  {slug === 'transformation-operating-model' && (
    <svg viewBox="0 0 180 96" role="img">
      <path d="M18 48H60M68 48H110M118 48H156" />
      <path d="M156 48c0 24-18 34-48 34H44c-18 0-26-8-26-20" />
      <path d="M18 62l-6-8M18 62l8-6" />
      <circle cx="18" cy="48" r="4" />
      <circle cx="64" cy="48" r="4" />
      <circle cx="114" cy="48" r="4" />
      <circle cx="160" cy="48" r="4" />
    </svg>
  )}
  {slug === 'ai-governance-without-theatre' && (
    <svg viewBox="0 0 180 96" role="img">
      <path d="M18 24H92M18 48H92M18 72H92" />
      <path d="M92 24L126 48M92 48H126M92 72L126 48" />
      <path d="M126 48H164" />
      <circle cx="18" cy="24" r="4" />
      <circle cx="18" cy="48" r="4" />
      <circle cx="18" cy="72" r="4" />
      <circle cx="164" cy="48" r="4" />
    </svg>
  )}
</div>

<style>
  .editorial-signature {
    color: var(--green);
    width: min(11rem, 100%);
  }

  .editorial-signature--inverse {
    color: var(--accent);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  path,
  circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }

  circle {
    fill: currentColor;
    stroke: none;
  }
</style>
