---
import type { CaseStudy } from '../content/case-studies';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
  item: CaseStudy;
  index: number;
  mode: 'portfolio' | 'impact' | 'governance';
}

const { locale, item, index, mode } = Astro.props;
const pl = locale === 'pl';
const impact = pl
  ? ['Procesy', 'Dane', 'Systemy', 'Integracje', 'Raportowanie', 'Rozliczenia']
  : ['Processes', 'Data', 'Systems', 'Integrations', 'Reporting', 'Settlement'];
const modeTitle = mode === 'portfolio'
  ? (pl ? 'Logika portfela' : 'Portfolio logic')
  : mode === 'impact'
    ? (pl ? 'Mapa wpływu' : 'Impact map')
    : (pl ? 'Prawa decyzyjne' : 'Decision rights');
const proofId = `proof-${mode}-${index}`;
---
<article class="case-study-item case-proof-item">
  <div class="case-study-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
  <div class="case-study-title">
    <p class="micro-label">{item.tag}</p>
    <h3>{item.title}</h3>
    <p>{item.context}</p>
  </div>
  <div class="case-study-detail">
    <p><strong>{pl ? 'Problem' : 'Challenge'}</strong><span>{item.challenge}</span></p>
    <p><strong>{pl ? 'Interwencja' : 'Intervention'}</strong><span>{item.approach}</span></p>
    <p class="case-study-value"><strong>{pl ? 'Wartość zarządcza' : 'Management value'}</strong><span>{item.value.replace(/^Wartość: |^Value: /, '')}</span></p>

    <figure class="proof-exhibit" aria-labelledby={proofId}>
      <figcaption id={proofId} class="proof-exhibit-head">
        <span>{mode === 'portfolio' ? 'PORTFOLIO LOGIC' : mode === 'impact' ? 'IMPACT LOGIC' : 'DECISION RIGHTS'}</span>
        <strong>{modeTitle}</strong>
      </figcaption>

      {mode === 'portfolio' && (
        <div class="proof-exhibit-canvas proof-portfolio" aria-hidden="true">
          <div class="proof-initiative-stack">
            <span>I-01</span><span>I-02</span><span>I-03</span><span>I-04</span>
          </div>
          <div class="proof-bridge">
            <small>{pl ? 'zależności + capacity' : 'dependencies + capacity'}</small>
            <i>→</i>
          </div>
          <div class="proof-capability-block">
            <small>{pl ? 'wspólne zdolności' : 'shared capabilities'}</small>
            <strong>C1 / C2</strong>
          </div>
          <div class="proof-bridge proof-bridge-short"><i>→</i></div>
          <div class="proof-decision-block">
            <small>{pl ? 'wybór portfela' : 'portfolio choice'}</small>
            <strong>STOP<br/>MERGE<br/>SEQUENCE<br/>CONTINUE</strong>
          </div>
        </div>
      )}

      {mode === 'impact' && (
        <div class="proof-exhibit-canvas proof-impact" aria-hidden="true">
          <div class="proof-impact-scope">
            <small>{pl ? 'powierzchnia zmiany' : 'change surface'}</small>
            <div class="proof-impact-tags">{impact.map((label) => <span>{label}</span>)}</div>
          </div>
          <div class="proof-impact-spine"><span>→</span></div>
          <div class="proof-impact-chain">
            <div><small>{pl ? 'zmiana' : 'change'}</small><strong>{pl ? 'przepływu' : 'flow'}</strong></div>
            <div><small>{pl ? 'zmiana' : 'change'}</small><strong>{pl ? 'kontroli' : 'control'}</strong></div>
            <div class="proof-impact-result"><small>{pl ? 'dowód wpływu' : 'impact evidence'}</small><strong>{pl ? 'co naprawdę się zmieniło?' : 'what actually changed?'}</strong></div>
          </div>
        </div>
      )}

      {mode === 'governance' && (
        <div class="proof-exhibit-canvas proof-governance" aria-hidden="true">
          <div class="proof-governance-before">
            <small>{pl ? 'przed / rozproszony mandat' : 'before / fragmented mandate'}</small>
            <span>FORUM A</span><span>FORUM B</span><span>FORUM C</span>
          </div>
          <div class="proof-governance-shift"><span>→</span><small>{pl ? 'jeden kontrakt decyzji' : 'one decision contract'}</small></div>
          <div class="proof-governance-after">
            <div class="proof-contract-row"><span>{pl ? 'Właściciel' : 'Owner'}</span><span>{pl ? 'Dowód' : 'Evidence'}</span><strong>{pl ? 'Decyzja' : 'Decision'}</strong></div>
            <div class="proof-review-loop"><span>↺</span><small>{pl ? 'przegląd / rytm / trigger ponownej decyzji' : 'review / cadence / revisit trigger'}</small></div>
          </div>
        </div>
      )}
    </figure>

    <p><strong>{pl ? 'Uwaga' : 'Note'}</strong><span>{pl ? 'Schemat pokazuje logikę pracy, nie dane klienta ani wynik KPI.' : 'The schematic shows the work logic, not client data or KPI outcomes.'}</span></p>
  </div>
</article>
