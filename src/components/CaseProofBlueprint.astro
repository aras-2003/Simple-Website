---
import type { CaseStudy } from '../content/case-studies';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
  item: CaseStudy;
  index: number;
  mode: 'portfolio' | 'impact' | 'governance';
}

const { locale, item, index, mode } = Astro.props;
const pl = locale === 'pl';
const impact = pl
  ? ['Procesy', 'Dane', 'Systemy', 'Integracje', 'Raportowanie', 'Rozliczenia']
  : ['Processes', 'Data', 'Systems', 'Integrations', 'Reporting', 'Settlement'];
---
<article class="case-study-item case-proof-item">
  <div class="case-study-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
  <div class="case-study-title">
    <p class="micro-label">{item.tag}</p>
    <h3>{item.title}</h3>
    <p>{item.context}</p>
  </div>
  <div class="case-study-detail">
    <p><strong>{pl ? 'Problem' : 'Challenge'}</strong><span>{item.challenge}</span></p>
    <p><strong>{pl ? 'Interwencja' : 'Intervention'}</strong><span>{item.approach}</span></p>
    <p class="case-study-value"><strong>{pl ? 'Wartość zarządcza' : 'Management value'}</strong><span>{item.value.replace(/^Wartość: |^Value: /, '')}</span></p>

    {mode === 'portfolio' && (
      <svg viewBox="0 0 760 250" width="100%" height="250" aria-hidden="true" focusable="false">
        <rect x="0" y="0" width="760" height="250" rx="2" fill="#252820" />
        <text x="30" y="28" fill="#c5ceb6" font-size="11" font-family="system-ui, sans-serif" letter-spacing="1.3">PORTFOLIO LOGIC / SCHEMATIC</text>
        {[0,1,2,3].map((i) => (
          <g>
            <rect x="30" y={54 + i * 40} width="112" height="28" fill="none" stroke="#66715f" />
            <text x="44" y={73 + i * 40} fill="#f6f0e7" font-size="11" font-family="system-ui, sans-serif">I-0{i + 1}</text>
            <line x1="142" y1={68 + i * 40} x2="245" y2="124" stroke="#8b9682" stroke-width="1" />
          </g>
        ))}
        <rect x="245" y="83" width="150" height="82" fill="#31372d" stroke="#8b9682" />
        <text x="264" y="112" fill="#c5ceb6" font-size="10" font-family="system-ui, sans-serif">{pl ? 'WSPÓLNE ZDOLNOŚCI' : 'SHARED CAPABILITIES'}</text>
        <text x="264" y="141" fill="#f6f0e7" font-size="19" font-family="system-ui, sans-serif">C1 / C2</text>
        <line x1="395" y1="124" x2="470" y2="124" stroke="#c5ceb6" stroke-width="1.5" />
        <path d="M470 124 l-10 -6 v12 z" fill="#c5ceb6" />
        <rect x="484" y="62" width="246" height="124" fill="#4d382f" stroke="#7f8d76" />
        <text x="506" y="92" fill="#c5ceb6" font-size="10" font-family="system-ui, sans-serif">{pl ? 'WYBÓR PORTFELA' : 'PORTFOLIO CHOICE'}</text>
        <text x="506" y="122" fill="#f6f0e7" font-size="15" font-family="system-ui, sans-serif">STOP · MERGE</text>
        <text x="506" y="148" fill="#f6f0e7" font-size="15" font-family="system-ui, sans-serif">SEQUENCE · CONTINUE</text>
        <text x="30" y="229" fill="#9da696" font-size="10" font-family="system-ui, sans-serif">{pl ? 'Zależności i capacity stają się częścią decyzji.' : 'Dependencies and capacity become part of the decision.'}</text>
      </svg>
    )}

    {mode === 'impact' && (
      <svg viewBox="0 0 760 250" width="100%" height="250" aria-hidden="true" focusable="false">
        <rect x="0" y="0" width="760" height="250" rx="2" fill="#252820" />
        <text x="30" y="28" fill="#c5ceb6" font-size="11" font-family="system-ui, sans-serif" letter-spacing="1.3">IMPACT MAP / SCHEMATIC</text>
        <circle cx="380" cy="126" r="48" fill="#4d382f" stroke="#8b9682" />
        <text x="380" y="120" text-anchor="middle" fill="#f6f0e7" font-size="32" font-family="system-ui, sans-serif">€</text>
        <text x="380" y="142" text-anchor="middle" fill="#c5ceb6" font-size="10" font-family="system-ui, sans-serif">IMPACT</text>
        {[
          [130,67, impact[0]], [315,48, impact[1]], [535,67, impact[2]],
          [130,176, impact[3]], [315,195, impact[4]], [535,176, impact[5]],
        ].map(([x,y,label]) => (
          <g>
            <line x1="380" y1="126" x2={Number(x) + 48} y2={Number(y) + 14} stroke="#66715f" />
            <rect x={Number(x)} y={Number(y)} width="96" height="28" fill="#31372d" stroke="#66715f" />
            <text x={Number(x) + 48} y={Number(y) + 18} text-anchor="middle" fill="#f6f0e7" font-size="9" font-family="system-ui, sans-serif">{label}</text>
          </g>
        ))}
      </svg>
    )}

    {mode === 'governance' && (
      <svg viewBox="0 0 760 250" width="100%" height="250" aria-hidden="true" focusable="false">
        <rect x="0" y="0" width="760" height="250" rx="2" fill="#252820" />
        <text x="30" y="28" fill="#c5ceb6" font-size="11" font-family="system-ui, sans-serif" letter-spacing="1.3">DECISION RIGHTS / SCHEMATIC</text>
        <text x="30" y="55" fill="#9da696" font-size="9" font-family="system-ui, sans-serif">{pl ? 'PRZED' : 'BEFORE'}</text>
        {['A','B','C'].map((label, i) => (
          <g>
            <rect x="30" y={70 + i * 45} width="126" height="30" fill="none" stroke="#66715f" />
            <text x="48" y={90 + i * 45} fill="#f6f0e7" font-size="11" font-family="system-ui, sans-serif">FORUM {label}</text>
            {i < 2 && <path d={`M156 ${85 + i * 45} C205 ${85 + i * 45}, 205 ${130 + i * 45}, 156 ${130 + i * 45}`} fill="none" stroke="#66715f" />}
          </g>
        ))}
        <line x1="210" y1="125" x2="294" y2="125" stroke="#c5ceb6" stroke-width="1.5" />
        <path d="M294 125 l-10 -6 v12 z" fill="#c5ceb6" />
        <text x="332" y="55" fill="#9da696" font-size="9" font-family="system-ui, sans-serif">{pl ? 'PO' : 'AFTER'}</text>
        {[
          [315,70, pl ? 'Właściciel decyzji' : 'Decision owner'],
          [468,70, pl ? 'Dowód' : 'Evidence'],
          [590,70, pl ? 'Decyzja' : 'Decision'],
          [468,155, pl ? 'Przegląd' : 'Review'],
        ].map(([x,y,label]) => (
          <g>
            <rect x={Number(x)} y={Number(y)} width="120" height="42" fill="#31372d" stroke="#7f8d76" />
            <text x={Number(x) + 60} y={Number(y) + 25} text-anchor="middle" fill="#f6f0e7" font-size="9" font-family="system-ui, sans-serif">{label}</text>
          </g>
        ))}
        <line x1="435" y1="91" x2="468" y2="91" stroke="#c5ceb6" /><line x1="588" y1="91" x2="590" y2="91" stroke="#c5ceb6" />
        <path d="M650 112 C650 190 528 208 528 197" fill="none" stroke="#8b9682" />
        <path d="M528 197 l-6 -10 h12 z" fill="#8b9682" />
        <text x="315" y="226" fill="#9da696" font-size="10" font-family="system-ui, sans-serif">{pl ? 'Mandat + dowód + rytm przeglądu.' : 'Mandate + evidence + review cadence.'}</text>
      </svg>
    )}
    <p><strong>{pl ? 'Uwaga' : 'Note'}</strong><span>{pl ? 'Schemat pokazuje logikę pracy, nie dane klienta ani wynik KPI.' : 'The schematic shows the work logic, not client data or KPI outcomes.'}</span></p>
  </div>
</article>
