---
import BaseLayout from '../layouts/BaseLayout.astro';
import StartConversation from './StartConversation.astro';
import { about } from '../content/about';
import type { Locale } from '../lib/site';
interface Props {locale:Locale;}
const {locale}=Astro.props; const x=about[locale];
---
<BaseLayout locale={locale} routeKey="about" title={`${locale==='pl'?'O mnie':'About'} – Arkadiusz Kamrowski`} description={x.lead}>
<section class="about-hero"><div><p class="eyebrow">{locale==='pl'?'O mnie':'About'}</p><h1>{x.title}</h1><p class="page-lead">{x.lead}</p></div><img src="/assets/arkadiusz-kamrowski-square-v2.webp" alt="Arkadiusz Kamrowski" width="400" height="400" fetchpriority="high" decoding="async"/></section>
<section class="section trajectory"><h2>{x.trajectoryTitle}</h2><div class="tension-list">{x.trajectory.map((item,index)=><article><span class="item-number" aria-hidden="true">0{index+1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
<section class="section convictions"><blockquote><p>“{x.quote}”</p><cite>Arkadiusz Kamrowski</cite></blockquote><div>{x.convictions.map(item=><article><h2>{item.title}</h2><p>{item.body}</p></article>)}</div></section>
<section class="section credentials-section"><h2>{x.credentialsTitle}</h2><ul>{x.credentials.map(item=><li>{item}</li>)}</ul></section>
<StartConversation locale={locale}/>
</BaseLayout>
