---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SectionLabel from './SectionLabel.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = copy[locale].pages.about;
const ia = editorial[locale].about;
---
<BaseLayout locale={locale} routeKey="about" title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} headline={p.headline} lead={p.lead} />

  <section class="section detail-grid" aria-label={locale === 'pl' ? 'Profil' : 'Profile'}>
    {p.sections.map((item, index) => (
      <article class="detail-row">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <h2>{item.title}</h2>
        <p>{item.body}</p>
      </article>
    ))}
  </section>

  <section class="section principle-page" aria-labelledby="principles-title">
    <SectionLabel no="04" label={ia.introEyebrow} />
    <div class="content-split">
      <h2 id="principles-title">{ia.introTitle}</h2>
      <p class="content-lead">{ia.introBody}</p>
    </div>
    <div class="principle-detail-grid principle-detail-editorial">
      {ia.principles.map((item, index) => (
        <article class="principle-detail-card">
          <div class="principle-card-top"><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3></div>
          <p class="principle-statement">{item.statement}</p>
          <p class="principle-practice">{item.practice}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section bridge-section bridge-editorial" aria-labelledby="bridge-title">
    <div class="bridge-map" aria-hidden="true">
      <span>01</span><strong>{locale === 'pl' ? 'Kierunek' : 'Direction'}</strong>
      <span>02</span><strong>{locale === 'pl' ? 'Architektura' : 'Architecture'}</strong>
      <span>03</span><strong>{locale === 'pl' ? 'Portfel' : 'Portfolio'}</strong>
      <span>04</span><strong>{locale === 'pl' ? 'Dowody' : 'Evidence'}</strong>
    </div>
    <div class="bridge-copy">
      <p class="eyebrow">{locale === 'pl' ? 'Perspektywa systemowa' : 'System view'}</p>
      <h2 id="bridge-title">{ia.bridgeTitle}</h2>
      <p>{ia.bridgeBody}</p>
      <div class="inline-actions">
        <a class="button button-primary" href={route(locale, 'oaf')}>{p.cta}<span aria-hidden="true">→</span></a>
        <a class="button button-quiet" href={route(locale, 'contact')}>{editorial[locale].nav.contact}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
