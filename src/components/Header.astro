---
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { alternateLocale, route, type Locale, type RouteKey } from '../lib/site';

interface Props { locale: Locale; current: RouteKey; alternateHref?: string | undefined; }
const { locale, current, alternateHref } = Astro.props;
const c = copy[locale];
const ia = editorial[locale];
const other = alternateLocale(locale);
const navKeys = ['work', 'oaf', 'writing', 'about', 'contact'] as const;
const langHref = alternateHref ?? route(other, current);
const langLabel = other.toUpperCase();
const navLabel = (key: typeof navKeys[number]) => key === 'work'
  ? (locale === 'pl' ? 'Współpraca' : 'Advisory')
  : ia.nav[key];
---
<header class="site-header">
  <a class="brand" href={route(locale, 'home')} aria-label={`Arkadiusz Kamrowski – ${c.nav.home}`}>
    <span class="brand-signature" aria-hidden="true">AK.</span>
    <span class="brand-wordmark"><span class="brand-first">Arkadiusz </span>Kamrowski</span>
  </a>

  <nav id="primary-navigation" class="site-nav desktop-nav" aria-label={c.navLabel}>
    {navKeys.map((key) => (
      <a class={key === 'contact' ? 'nav-cta' : undefined} href={route(locale, key)} aria-current={current === key ? 'page' : undefined}>{navLabel(key)}</a>
    ))}
    <a class="language-link" href={langHref} lang={other} hreflang={other}>{langLabel}</a>
  </nav>

  <details class="mobile-nav">
    <summary><span>{c.menu}</span><span aria-hidden="true">＋</span></summary>
    <nav aria-label={c.navLabel}>
      {navKeys.map((key) => (
        <a class={key === 'contact' ? 'nav-cta' : undefined} href={route(locale, key)} aria-current={current === key ? 'page' : undefined}>{navLabel(key)}</a>
      ))}
      <a class="language-link" href={langHref} lang={other} hreflang={other}>{langLabel}</a>
    </nav>
  </details>
</header>
