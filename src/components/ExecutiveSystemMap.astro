---
import type { Locale } from '../lib/site';

interface Props { locale: Locale; compact?: boolean; }
const { locale, compact = false } = Astro.props;
const pl = locale === 'pl';
const stages = pl
  ? [
      ['Kierunek', 'strategia'],
      ['Model działania', 'operating model'],
      ['Architektura', 'zdolności + tech'],
      ['Portfel', 'kapitał + kolejność'],
      ['Wykonanie', 'rezultat + dowód'],
    ]
  : [
      ['Direction', 'strategy'],
      ['Operating model', 'ways of working'],
      ['Architecture', 'capability + tech'],
      ['Portfolio', 'capital + sequence'],
      ['Execution', 'outcome + evidence'],
    ];
---
<figure class:list={['decision-system', { 'decision-system-compact': compact }]}>
  <div class="decision-system-head">
    <p>{pl ? 'system decyzji' : 'decision system'}</p>
    <span>{pl ? 'największe ryzyko jest na przejściach' : 'the highest risk sits at the hand-offs'}</span>
  </div>

  <div class="decision-system-chain" aria-hidden="true">
    {stages.map(([title, meta], index) => (
      <>
        <div class="decision-system-node">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{title}</strong>
          <small>{meta}</small>
        </div>
        {index < stages.length - 1 && (
          <div class:list={['decision-system-handoff', { 'decision-system-handoff-risk': index === 1 || index === 2 }]}> 
            <span></span>
            {(index === 1 || index === 2) && <small>{pl ? 'tarcie' : 'friction'}</small>}
          </div>
        )}
      </>
    ))}
  </div>

  <div class="decision-system-feedback" aria-hidden="true">
    <span class="decision-feedback-arrow">↩</span>
    <span>{pl ? 'dowód z wykonania wraca do kolejnej decyzji' : 'execution evidence feeds the next decision'}</span>
  </div>

  <figcaption>
    <strong>{pl ? 'Wartość nie znika w jednym silosie.' : 'Value rarely disappears inside one silo.'}</strong>
    <span>{pl ? 'Najczęściej znika na przejściach — gdy zmieniają się właściciel, kryterium albo rytm decyzji.' : 'It disappears at the hand-offs — when ownership, criteria or decision cadence changes along the way.'}</span>
  </figcaption>
</figure>