---
import type { Locale } from '../lib/site';

interface Props { locale: Locale; compact?: boolean; }
const { locale, compact = false } = Astro.props;
const pl = locale === 'pl';
const stages = pl
  ? [
      ['Kierunek', 'strategia'],
      ['Model działania', 'operating model'],
      ['Architektura', 'zdolności + tech'],
      ['Portfel', 'kapitał + kolejność'],
      ['Wykonanie', 'rezultat + dowód'],
    ]
  : [
      ['Direction', 'strategy'],
      ['Operating model', 'ways of working'],
      ['Architecture', 'capability + tech'],
      ['Portfolio', 'capital + sequence'],
      ['Execution', 'outcome + evidence'],
    ];
---
<figure class:list={['decision-system', { 'decision-system-compact': compact }]}>
  <div class="decision-system-head">
    <p>{pl ? 'system decyzji' : 'decision system'}</p>
    <span>{pl ? 'ryzyko rośnie na przejściach' : 'risk compounds at the hand-offs'}</span>
  </div>

  <ol class="decision-system-chain">
    {stages.map(([title, meta], index) => {
      const risk = index === 1 || index === 2;
      return (
        <li class:list={['decision-system-stage', { 'decision-system-stage-risk': risk }]}>
          <span class="decision-system-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="decision-system-stage-copy">
            <strong>{title}</strong>
            <small>{meta}</small>
          </div>
          {index < stages.length - 1 && (
            <div class="decision-system-handoff" aria-hidden="true">
              <span></span>
              <small>{risk ? (pl ? 'tarcie' : 'friction') : (pl ? 'przejście' : 'handoff')}</small>
            </div>
          )}
        </li>
      );
    })}
  </ol>

  <div class="decision-system-feedback">
    <span class="decision-feedback-arrow" aria-hidden="true">↺</span>
    <span>{pl ? 'Dowód z wykonania wraca do kolejnej decyzji.' : 'Execution evidence feeds the next decision.'}</span>
  </div>

  <figcaption>
    <strong>{pl ? 'Wartość nie znika w jednym silosie.' : 'Value rarely disappears inside one silo.'}</strong>
    <span>{pl ? 'Najczęściej traci się ją przy zmianie właściciela, kryterium lub rytmu decyzji.' : 'It is usually lost when ownership, criteria or decision cadence changes.'}</span>
  </figcaption>
</figure>
