---
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pl = locale === 'pl';
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';
const topics = pl
  ? [
      ['architecture', 'Enterprise Architecture'],
      ['strategy', 'Strategia i transformacja'],
      ['portfolio', 'PMO i portfolio'],
      ['ai', 'AI i technologia'],
      ['speaking', 'Wystąpienie / debata'],
      ['other', 'Inny temat'],
    ]
  : [
      ['architecture', 'Enterprise Architecture'],
      ['strategy', 'Strategy & transformation'],
      ['portfolio', 'PMO & portfolio'],
      ['ai', 'AI & technology'],
      ['speaking', 'Speaking / panel'],
      ['other', 'Other'],
    ];
---
<form
  class="contact-form"
  data-contact-form
  data-endpoint={endpoint}
  data-success={pl ? 'Dziękuję. Wiadomość została wysłana.' : 'Thank you. Your message has been sent.'}
  data-error={pl ? 'Nie udało się wysłać wiadomości. Spróbuj ponownie lub napisz przez LinkedIn.' : 'The message could not be sent. Try again or use LinkedIn.'}
  data-validation={pl ? 'Sprawdź pola formularza i spróbuj ponownie.' : 'Check the form fields and try again.'}
  data-rate-limit={pl ? 'Za dużo prób w krótkim czasie. Spróbuj ponownie za kilka minut.' : 'Too many attempts in a short time. Try again in a few minutes.'}
  data-delivery={pl ? 'Usługa wysyłki jest chwilowo niedostępna. Spróbuj później lub użyj LinkedIn.' : 'Message delivery is temporarily unavailable. Try later or use LinkedIn.'}
  data-sending={pl ? 'Wysyłanie…' : 'Sending…'}
  novalidate
>
  <div class="form-grid">
    <div class="field">
      <label for={`name-${locale}`}>{pl ? 'Imię i nazwisko' : 'Name'}</label>
      <input id={`name-${locale}`} name="name" type="text" autocomplete="name" minlength="2" maxlength="120" required />
    </div>
    <div class="field">
      <label for={`email-${locale}`}>E-mail</label>
      <input id={`email-${locale}`} name="email" type="email" autocomplete="email" maxlength="254" required />
    </div>
    <div class="field">
      <label for={`organization-${locale}`}>{pl ? 'Organizacja' : 'Organization'} <span>{pl ? 'opcjonalnie' : 'optional'}</span></label>
      <input id={`organization-${locale}`} name="organization" type="text" autocomplete="organization" maxlength="140" />
    </div>
    <div class="field">
      <label for={`topic-${locale}`}>{pl ? 'Temat' : 'Topic'}</label>
      <select id={`topic-${locale}`} name="topic" required>
        <option value="">{pl ? 'Wybierz temat' : 'Choose a topic'}</option>
        {topics.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
  </div>

  <div class="field field-message">
    <label for={`message-${locale}`}>{pl ? 'Wiadomość' : 'Message'}</label>
    <textarea id={`message-${locale}`} name="message" rows="7" minlength="20" maxlength="4000" required placeholder={pl ? 'Kontekst, decyzja do podjęcia, najważniejsze ograniczenia…' : 'Context, decision to be made, key constraints…'}></textarea>
    <p class="field-hint">{pl ? '20–4000 znaków. Nie przesyłaj danych poufnych ani haseł.' : '20–4000 characters. Do not send confidential data or passwords.'}</p>
  </div>

  <div class="form-honeypot" hidden>
    <label for={`website-${locale}`}>Website</label>
    <input id={`website-${locale}`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <label class="consent-row">
    <input name="consent" type="checkbox" required />
    <span>{pl ? 'Zgadzam się na przetworzenie danych w celu obsługi tej wiadomości.' : 'I agree to the processing of my data for the purpose of handling this message.'} <a href={route(locale, 'privacy')}>{pl ? 'Prywatność' : 'Privacy'}</a>.</span>
  </label>

  <div class="form-footer">
    <button class="button button-primary button-large" type="submit">
      <span>{pl ? 'Wyślij wiadomość' : 'Send message'}</span><span aria-hidden="true">→</span>
    </button>
    <p class="form-status" data-form-status role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</form>

<script>
  const forms = document.querySelectorAll('[data-contact-form]');
  const validationErrors = new Set([
    'consent_required',
    'invalid_name',
    'invalid_email',
    'invalid_organization',
    'invalid_topic',
    'invalid_message',
    'invalid_timing',
    'invalid_json',
    'json_required',
    'payload_too_large',
  ]);

  for (const form of forms) {
    if (!(form instanceof HTMLFormElement)) continue;
    form.dataset.startedAt = String(Date.now());
    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (!(submit instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

      const original = submit.innerHTML;
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.textContent = form.dataset.sending || 'Sending…';
      status.textContent = '';
      status.removeAttribute('data-state');

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        organization: String(data.get('organization') || ''),
        topic: String(data.get('topic') || ''),
        message: String(data.get('message') || ''),
        website: String(data.get('website') || ''),
        consent: data.get('consent') === 'on',
        locale: document.documentElement.lang === 'en' ? 'en' : 'pl',
        startedAt: Number(form.dataset.startedAt || Date.now()),
      };

      const endpoint = form.dataset.endpoint || '/api/contact';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) {
          const code = typeof body?.error === 'string' ? body.error : 'request_failed';
          throw new Error(code);
        }
        form.reset();
        form.dataset.startedAt = String(Date.now());
        status.dataset.state = 'success';
        status.textContent = form.dataset.success || 'Sent.';
      } catch (error) {
        const code = error instanceof Error ? error.message : 'request_failed';
        status.dataset.state = 'error';
        if (code === 'rate_limited') {
          status.textContent = form.dataset.rateLimit || form.dataset.error || 'Could not send.';
        } else if (code === 'delivery_unavailable') {
          status.textContent = form.dataset.delivery || form.dataset.error || 'Could not send.';
        } else if (validationErrors.has(code)) {
          status.textContent = form.dataset.validation || form.dataset.error || 'Could not send.';
        } else {
          status.textContent = form.dataset.error || 'Could not send.';
        }
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        submit.innerHTML = original;
      }
    });
  }
</script>
