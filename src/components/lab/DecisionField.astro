---
interface Props { kind: 'hero' | 'system'; }
const { kind } = Astro.props;
import { theatre } from '../../content/decision-theatre';
const c = theatre.pl;
const desktop = [
  [620, 64], [875, 79], [453, 157], [781, 165], [534, 249], [864, 260],
  [408, 353], [712, 347], [540, 449], [873, 445], [704, 553],
];
const mobile = [
  [173, 51], [303, 57], [130, 152], [265, 152], [142, 254], [279, 254],
  [123, 356], [260, 356], [136, 458], [286, 458], [202, 560],
];
const path = (points: number[][], route: number[]) => route.map((id, i) => {
  const [x, y] = points[id]!;
  if (!i) return `M ${x} ${y}`;
  const [px, py] = points[route[i - 1]!]!;
  if (Math.abs(y! - py!) < 40) return `C ${px! + 45} ${py! + 32} ${x! - 45} ${y! + 32} ${x} ${y}`;
  return `C ${px} ${py! + 54} ${x} ${y! - 54} ${x} ${y}`;
}).join(' ');
---
{kind === 'hero' ? (
  <figure class="dt-field dt-hero-field" aria-label="TAK wyznacza kierunek, NIE uwalnia zasoby, KTO bierze odpowiedzialność. Jedna decyzja łączy organizację z wynikiem.">
    <svg viewBox="0 0 640 640" fill="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="dt-hero-surface" x1="50" y1="0" x2="510" y2="580" gradientUnits="userSpaceOnUse"><stop stop-color="#2e5346"/><stop offset="1" stop-color="#102c24"/></linearGradient>
        <linearGradient id="dt-hero-edge"><stop stop-color="#c0d49a" stop-opacity="0"/><stop offset=".5" stop-color="#c0d49a" stop-opacity=".65"/><stop offset="1" stop-color="#c0d49a" stop-opacity="0"/></linearGradient>
      </defs>
      <g class="dt-hero-orbits">
        <path class="dt-orbit" d="M25 291 C100 180 514 128 608 236 C702 344 271 578 63 489 C-20 454 -15 367 25 291Z"/>
        <path class="dt-orbit" d="M56 271 C133 157 493 131 572 247 C662 380 250 554 84 463 C15 425 17 329 56 271Z"/>
        <path class="dt-orbit dt-orbit-short" d="M52 421 C222 509 549 344 588 243"/>
      </g>
      <g class="dt-leaf dt-leaf-back">
        <path class="dt-plane" d="M99 373 Q316 261 559 326 L528 474 Q303 565 84 462Z"/>
        <path class="dt-plane-edge" d="M84 462 Q303 565 528 474"/>
        <text class="dt-hero-number" x="121" y="403">03 / ODPOWIEDZIALNOŚĆ</text>
        <text class="dt-hero-word" x="164" y="470">KTO</text>
        <circle class="dt-terminal" cx="458" cy="435" r="5"/>
      </g>
      <g class="dt-leaf dt-leaf-mid">
        <path class="dt-plane" d="M80 241 Q310 164 536 221 L560 338 Q340 434 95 345Z"/>
        <path class="dt-plane-edge" d="M95 345 Q340 434 560 338"/>
        <text class="dt-hero-number" x="113" y="265">02 / KONCENTRACJA</text>
        <text class="dt-hero-word dt-word-no" x="163" y="335">NIE</text>
        <path class="dt-stop" d="M420 298 H438 M429 289 V307"/>
      </g>
      <g class="dt-leaf dt-leaf-front">
        <path class="dt-plane" d="M129 98 Q324 44 542 100 L503 225 Q307 289 90 204Z"/>
        <path class="dt-plane-edge" d="M90 204 Q307 289 503 225"/>
        <text class="dt-hero-number" x="148" y="124">01 / KIERUNEK</text>
        <text class="dt-hero-word" x="175" y="207">TAK</text>
        <circle class="dt-terminal" cx="427" cy="181" r="5"/>
      </g>
      <path class="dt-hero-trail-glow" d="M427 181 C545 225 316 326 369 369 S490 394 458 435 Q429 486 367 537"/>
      <path class="dt-hero-trail" pathLength="1" d="M427 181 C545 225 316 326 369 369 S490 394 458 435 Q429 486 367 537"/>
      <path class="dt-hero-signal dt-flow" pathLength="1" d="M427 181 C545 225 316 326 369 369 S490 394 458 435 Q429 486 367 537"/>
      <circle class="dt-outcome-ring" cx="367" cy="537" r="10"/>
      <circle class="dt-outcome-dot" cx="367" cy="537" r="3"/>
      <text class="dt-outcome-label" x="393" y="542">WYNIK</text>
      <path class="dt-hairline" d="M55 565 H270"/>
      <text class="dt-hero-note" x="55" y="586">WYBÓR URUCHAMIA CAŁY SYSTEM</text>
    </svg>
    <figcaption class="dt-field-caption"><span>Architektura organizacji</span><span>Od wyboru do wyniku ↗</span></figcaption>
  </figure>
) : (
  <div class="dt-topology" aria-hidden="true">
    {(['desktop', 'mobile'] as const).map((format) => {
      const narrow = format === 'mobile';
      const points = narrow ? mobile : desktop;
      return <svg class={`dt-map dt-map-${format}`} viewBox={narrow ? '0 0 380 612' : '0 0 1200 610'} fill="none" focusable="false">
        <defs><linearGradient id={`dt-wash-${format}`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#b4ce98" stop-opacity=".09"/><stop offset="1" stop-color="#b4ce98" stop-opacity="0"/></linearGradient></defs>
        <g class="dt-map-depth">
          {c.layers.map((layer, i) => {
            const y = narrow ? 51 + i * 102 : 65 + i * 97;
            const left = narrow ? 70 : 315 + (i % 2) * -58;
            const right = narrow ? 347 : 1060 + (i % 2) * -55;
            return <g class="dt-stratum">
              <path fill={`url(#dt-wash-${format})`} class="dt-contour" d={`M${left} ${y + 13} C${left + 90} ${y - 49} ${right - 120} ${y - 52} ${right} ${y - 6} C${right + 45} ${y + 35} ${left + 100} ${y + 72} ${left} ${y + 13}Z`}/>
              <path class="dt-contour-front" d={`M${left} ${y + 13} C${left + 100} ${y + 72} ${right + 45} ${y + 35} ${right} ${y - 6}`}/>
              <text class="dt-layer-index" x={narrow ? 8 : 35} y={narrow ? y - 24 : y - 3}>0{i + 1}</text>
              <text class="dt-layer-name" x={narrow ? 8 : 69} y={narrow ? y - 7 : y - 3}>{layer}</text>
              {!narrow && <path class="dt-layer-rule" d={`M${i === 2 ? 223 : 172} ${y - 7} H${left - 24}`}/>}
            </g>;
          })}
          <g class="dt-background-links">{[[0,3,5,7,8,10], [1,2,4,6,9,10], [0,2,5,6,8,10]].map(route => <path d={path(points, route)}/>)}</g>
          {c.modes.map((mode, i) => <g class="dt-route" data-route={i}>
            <path class="dt-route-glow" d={path(points, mode.path)}/>
            <path class="dt-route-line" pathLength="1" d={path(points, mode.path)}/>
            <path class="dt-route-signal dt-flow" pathLength="1" d={path(points, mode.path)}/>
          </g>)}
          {points.map(([x, y], i) => <g class:list={['dt-node', {'is-active': c.modes[0]!.path.includes(i)}]} data-node={i}>
            <circle class="dt-node-halo" cx={x} cy={y} r={i === 10 ? 18 : 12}/>
            <circle class="dt-node-core" cx={x} cy={y} r={i === 10 ? 5 : 3.5}/>
            <text x={x! + (narrow ? 10 : 15)} y={y! - 13}>{c.nodes[i]}</text>
          </g>)}
        </g>
      </svg>;
    })}
  </div>
)}
