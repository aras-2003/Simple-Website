---
import DecisionSpine from './DecisionSpine.astro';

const stages = [
  {
    step: '01',
    eyebrow: 'FRICTION',
    title: 'Wiele elementów.\nBrak wspólnego ruchu.',
    body: 'Strategia, odpowiedzialność, architektura, portfel i wykonanie istnieją jednocześnie — ale nie tworzą jeszcze jednego systemu.',
    principle: 'Najpierw zobacz zależności.',
  },
  {
    step: '02',
    eyebrow: 'ALIGN',
    title: 'Najpierw wspólny\nkierunek.',
    body: 'Warstwy porządkują się wokół jednego celu. Priorytet staje się widoczny w inwestycjach, mandatach i architekturze.',
    principle: 'Wyrównaj system przed przyspieszeniem.',
  },
  {
    step: '03',
    eyebrow: 'DECIDE',
    title: 'Decyzja przecina\ncały system.',
    body: 'YES / NO / WHO nie jest osobnym spotkaniem. To linia, która przechodzi przez strategię, odpowiedzialność, technologię i portfel.',
    principle: 'Wybór musi zmieniać geometrię działania.',
  },
  {
    step: '04',
    eyebrow: 'EXECUTE',
    title: 'Wykonanie wraca\njako informacja.',
    body: 'Po decyzji struktura otwiera drogę do działania. Sygnały z wykonania wracają do systemu i kształtują następny wybór.',
    principle: 'Mierz efekt, nie tylko wdrożenie.',
  },
];
---
<div class="dv" data-dv>
  <header class="dv-header dv-shell">
    <a class="dv-brand" href="/" aria-label="Arkadiusz Kamrowski — strona główna">
      <span class="dv-monogram">AK<span>.</span></span>
      <span class="dv-wordmark">Arkadiusz<br />Kamrowski</span>
    </a>
    <span class="dv-header-line">STRATEGIA · ORGANIZACJA · TECHNOLOGIA</span>
    <span class="dv-lab">MOTION STUDY <span>/ V2</span></span>
  </header>

  <main id="main" tabindex="-1">
    <section class="dv-journey" data-journey aria-labelledby="dv-title">
      <div class="dv-stage">
        <div class="dv-paper-grid" aria-hidden="true"></div>
        <div class="dv-dark-field" data-dark-field aria-hidden="true"></div>

        <div class="dv-shell dv-stage-grid">
          <div class="dv-copy">
            <div class="dv-hero-copy" data-hero-copy>
              <p class="dv-kicker">DLA ZARZĄDÓW I LIDERÓW TECHNOLOGII</p>
              <h1 id="dv-title">Strategię widać<br /><em>w wyborach.</em></h1>
              <p class="dv-lead">Co finansować. Kto decyduje.<br />Jak zamienić zamiar w wynik.</p>
              <p class="dv-intro">Łączę strategię, organizację i technologię, żeby decyzje przekładały się na działanie.</p>
              <div class="dv-actions">
                <a class="dv-cta" href="/contact">Porozmawiajmy <span aria-hidden="true">↗</span></a>
                <a class="dv-text-link" href="#motion-system">Zobacz system <span aria-hidden="true">↓</span></a>
              </div>
            </div>

            <div class="dv-stories" id="motion-system">
              {stages.map((stage, i) => (
                <article class="dv-story" data-story={i} aria-hidden={i === 0 ? 'false' : 'true'}>
                  <p class="dv-story-meta"><span>{stage.step}</span>{stage.eyebrow}</p>
                  <h2>{stage.title.split('\n').map((line, j) => <>{j > 0 && <br />}{line}</>)}</h2>
                  <p class="dv-story-body">{stage.body}</p>
                  <p class="dv-principle">{stage.principle}</p>
                </article>
              ))}
            </div>
          </div>

          <figure class="dv-object">
            <DecisionSpine />
            <figcaption>
              <span>JEDEN SYSTEM / CZTERY STANY</span>
              <span data-stage-caption>FRICTION → ALIGN</span>
            </figcaption>
          </figure>
        </div>

        <div class="dv-shell dv-progress" aria-hidden="true">
          {stages.map((stage, i) => (
            <div class="dv-progress-step" data-progress-step={i}>
              <span>{stage.step}</span><i></i><b>{stage.eyebrow}</b>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="dv-after dv-shell" aria-labelledby="dv-after-title">
      <p class="dv-kicker">THE PRINCIPLE</p>
      <div>
        <h2 id="dv-after-title">Nie projektuję struktur.<br /><em>Projektuję przepływ decyzji.</em></h2>
        <p>Forma ma być zrozumiała zanim pojawi się opis: elementy są rozproszone, ustawiają się wokół celu, decyzja przecina cały system, a wykonanie zamienia strukturę w przepływ.</p>
      </div>
    </section>
  </main>

  <footer class="dv-footer dv-shell">
    <span>© {new Date().getFullYear()} Arkadiusz Kamrowski</span>
    <a href="/contact">Porozmawiajmy o trudnej decyzji ↗</a>
    <span>LAB / MOTION V2</span>
  </footer>
</div>
<script>import '../../scripts/decision-theatre-v2';</script>
