---
import ProofStories from './ProofStories.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StartConversation from './StartConversation.astro';
import EnterpriseDecisionGraph from './EnterpriseDecisionGraph.astro';
import { home } from '../content/home';
import { journey } from '../content/journey';
import { route, type Locale } from '../lib/site';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const x=home[locale];
---
<BaseLayout locale={locale} routeKey="home" title={`Arkadiusz Kamrowski – ${x.title} ${x.emphasis}`} description={x.lead}>
 <section class="executive-hero executive-hero--graph" aria-labelledby="hero-title">
  <div class="executive-hero-copy"><p class="eyebrow">{x.audience}</p><h1 id="hero-title">{x.title} <em>{x.emphasis}</em></h1><p class="hero-lead">{x.lead}</p><div class="hero-actions"><a class="button button-primary" href={route(locale,'contact')}>{journey[locale].cta}<span aria-hidden="true">↗</span></a><a class="text-link" href={route(locale,'work')}>{x.advisory}</a></div><div class="signature-choices signature-choices--compact" aria-label={locale === 'pl' ? 'Trzy pytania: tak, nie, kto' : 'Three questions: yes, no, who'}>{x.signature.map(item => <span class="signature-choice"><strong>{item.word}</strong><span>{item.meaning}</span></span>)}</div></div>
  <EnterpriseDecisionGraph locale={locale} mode="hero" />
 </section>
 <EnterpriseDecisionGraph locale={locale} mode="system" />
 <section class="section tension-section" aria-labelledby="tension-title"><h2 id="tension-title">{x.tensionsTitle}</h2><div class="tension-list">{x.tensions.map((item,index)=><article><span class="item-number" aria-hidden="true">0{index+1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
 <ProofStories locale={locale} compact/>
 <section class="section human-section" aria-labelledby="person-title"><img src="/assets/arkadiusz-kamrowski-square-v2.webp" alt="Arkadiusz Kamrowski" width="400" height="400" loading="lazy" decoding="async"/><div><p class="eyebrow">Arkadiusz Kamrowski</p><h2 id="person-title">{x.personTitle}</h2><p>{x.personBody}</p><p class="human-credential">MBA · {locale==='pl'?'Akademia Leona Koźmińskiego':'Kozminski University'} · Best Strategic Business Project</p><a class="text-link" href={route(locale,'about')}>{x.personLink}<span aria-hidden="true">↗</span></a></div></section>
 <StartConversation locale={locale}/>
 <aside class="method-note"><p>{x.method}</p><a class="text-link" href={route(locale,'oaf')}>{x.methodLink}</a></aside>
</BaseLayout>
<style is:global>
  .executive-hero--graph{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(1.5rem,5vw,5rem);padding-block:clamp(3.5rem,7vw,6.5rem);min-height:580px}
  .executive-hero--graph .edg-hero{align-self:center}
  .executive-hero--graph .signature-choices--compact{background:none;color:var(--green);padding:0;transform:none;box-shadow:none;display:flex;gap:clamp(.8rem,2vw,1.8rem);flex-wrap:wrap;margin-top:3rem;border-top:1px solid var(--line);padding-top:1rem}
  .executive-hero--graph .signature-choices--compact .signature-choice{display:flex;flex-direction:column;gap:.2rem;border:0;padding:0;min-width:0}
  .executive-hero--graph .signature-choices--compact .signature-choice strong{font:600 12px/1.4 var(--sans);letter-spacing:.1em;color:var(--green)}
  .executive-hero--graph .signature-choices--compact .signature-choice:nth-child(2) strong{font-style:normal;color:var(--green)}
  .executive-hero--graph .signature-choices--compact .signature-choice>span:last-child{font-size:12px;line-height:1.4;color:var(--muted)}
  @media(max-width:760px){.executive-hero--graph{grid-template-columns:minmax(0,1fr);min-height:0;gap:1rem;padding-block:3.5rem 2.5rem}.executive-hero--graph .edg-hero{width:min(100%,330px)}.executive-hero--graph .signature-choices--compact{margin-top:2rem}}
</style>
