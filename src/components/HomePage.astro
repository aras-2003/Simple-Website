---
import BaseLayout from '../layouts/BaseLayout.astro';
import OafDiagram from './OafDiagram.astro';
import SectionLabel from './SectionLabel.astro';
import { copy, sharedContent } from '../i18n/content';
import { route, site, type Locale } from '../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = copy[locale];
const p = c.pages.home;
const localDetail = (item: typeof sharedContent.system[number]) => locale === 'pl' ? item.detailPl : item.detailEn;
const proofLabel = locale === 'pl' ? 'Wybrane sygnały wiarygodności' : 'Selected credibility signals';
---
<BaseLayout locale={locale} routeKey="home" title={p.title} description={p.description}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 id="hero-title">{p.headlineA} <em>{p.headlineEm}</em></h1>
      <p class="hero-lead">{p.lead}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={route(locale, 'oaf')}>{p.primary}<span aria-hidden="true">→</span></a>
        <a class="button button-quiet" href={site.linkedIn} target="_blank" rel="noopener noreferrer">
          {p.secondary}<span aria-hidden="true">↗</span><span class="sr-only"> — {c.externalNewTab}</span>
        </a>
      </div>
    </div>

    <aside class="hero-system" aria-labelledby="system-title">
      <div class="hero-system-stage" aria-hidden="true">
        <div class="hero-grid-glow"></div>
        <div class="hero-orbit orbit-a"></div>
        <div class="hero-orbit orbit-b"></div>
        <div class="hero-orbit orbit-c"></div>
        <div class="hero-line line-a"></div>
        <div class="hero-line line-b"></div>
        <div class="hero-line line-c"></div>
        <span class="hero-core">OAF</span>
        {sharedContent.system.map((item, index) => (
          <span class={`hero-chip hero-chip-${index + 1}`} lang="en">{item.title}</span>
        ))}
      </div>
      <div class="hero-system-copy">
        <p class="system-kicker" id="system-title">{p.systemKicker}</p>
        <ol class="system-nodes">
          {sharedContent.system.map((item) => (
            <li>
              <span class="node-index">{item.index}</span>
              <strong lang="en">{item.title}</strong>
              <small>{localDetail(item)}</small>
            </li>
          ))}
        </ol>
        <p class="system-note">{p.systemNote}</p>
      </div>
    </aside>

    <div class="proof-strip" aria-label={proofLabel}>
      <p class="proof-kicker">{proofLabel}</p>
      <dl class="hero-metrics">
        {p.metrics.map((metric) => (
          <div><dt>{metric.value}</dt><dd>{metric.label}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section-about" aria-labelledby="about-title">
    <SectionLabel no="01" label={p.aboutLabel} />
    <div class="manifesto">
      <h2 id="about-title">{p.aboutTitleA} <em>{p.aboutTitleEm}</em></h2>
      <p>{p.aboutBody}</p>
    </div>
    <div class="principles">
      {p.principles.map((principle) => (
        <article>
          <span class="principle-no" aria-hidden="true">{principle.key}</span>
          <h3 lang="en">{principle.title}</h3>
          <p>{principle.body}</p>
        </article>
      ))}
    </div>
    <p class="section-more"><a class="text-link" href={route(locale, 'about')}>{c.nav.about}<span aria-hidden="true">→</span></a></p>
  </section>

  <section class="section section-oaf" aria-labelledby="oaf-title">
    <SectionLabel no="02" label={p.oafLabel} />
    <div class="oaf-layout">
      <div class="oaf-intro">
        <p class="eyebrow" lang="en">Working model</p>
        <h2 id="oaf-title">{p.oafTitleA} <em>{p.oafTitleEm}</em></h2>
        <p>{p.oafBody}</p>
        <p class="section-more"><a class="text-link" href={route(locale, 'oaf')}>{p.primary}<span aria-hidden="true">→</span></a></p>
      </div>
      <OafDiagram locale={locale} id="home-oaf-diagram" compact />
    </div>
  </section>

  <section class="section section-quote" aria-label={locale === 'pl' ? 'Punkt widzenia' : 'Point of view'}>
    <div class="quote-shell">
      <span class="quote-mark" aria-hidden="true">—</span>
      <p class="quote-kicker">{locale === 'pl' ? 'Punkt widzenia' : 'Point of view'}</p>
      <blockquote>{p.quote}</blockquote>
    </div>
  </section>

  <section class="section section-focus" aria-labelledby="focus-title">
    <SectionLabel no="03" label={p.focusLabel} />
    <div class="focus-header">
      <h2 id="focus-title">{p.focusTitle}</h2>
      <p>{p.focusBody}</p>
    </div>
    <div class="focus-list">
      {sharedContent.focus.map((item, index) => (
        <article>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 lang="en">{item.title}</h3>
          <p lang="en">{item.body}</p>
        </article>
      ))}
    </div>
    <p class="section-more"><a class="text-link" href={route(locale, 'work')}>{c.nav.work}<span aria-hidden="true">→</span></a></p>
  </section>

  <section class="section section-signals" aria-labelledby="signals-title">
    <SectionLabel no="04" label={p.signalsLabel} />
    <div class="signals-header"><h2 id="signals-title">{p.signalsTitle}</h2></div>
    <div class="timeline">
      {p.signals.map((signal) => (
        <article>
          <p class="timeline-time">{signal.time}</p>
          <h3>{signal.title}</h3>
          <p>{signal.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-contact" aria-labelledby="contact-title">
    <div class="contact-copy">
      <p class="eyebrow">Contact / LinkedIn</p>
      <h2 id="contact-title">{p.contactTitle}</h2>
      <p>{p.contactBody}</p>
    </div>
    <div class="contact-action">
      <a class="button button-primary button-large" href={site.linkedIn} target="_blank" rel="noopener noreferrer">
        {p.contactCta}<span aria-hidden="true">↗</span><span class="sr-only"> — {c.externalNewTab}</span>
      </a>
    </div>
  </section>
</BaseLayout>
