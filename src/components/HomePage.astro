---
import BaseLayout from '../layouts/BaseLayout.astro';
import OafDiagram from './OafDiagram.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { getNotes } from '../content/notes';
import { platform } from '../content/platform';
import { route, site, type Locale } from '../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = copy[locale];
const ia = editorial[locale];
const x = platform[locale];
const notes = getNotes(locale).slice(0, 3);
const perspectiveBase = route(locale, 'writing');
const noteHref = (slug: string) => `${perspectiveBase}/${slug}`;
const title = locale === 'pl'
  ? 'Arkadiusz Kamrowski — architektura organizacyjna, strategia i wykonanie'
  : 'Arkadiusz Kamrowski — organizational architecture, strategy and execution';
const description = locale === 'pl'
  ? 'Perspektywa o tym, jak łączyć strategię, architekturę, portfel, ład decyzyjny i wykonanie w jeden system decyzji.'
  : 'A perspective on connecting strategy, architecture, portfolio, governance and execution into one decision system.';
---
<BaseLayout locale={locale} routeKey="home" title={title} description={description}>
  <section class="landing-hero" aria-labelledby="hero-title">
    <div class="landing-hero-copy">
      <p class="eyebrow">{x.home.hero.eyebrow}</p>
      <h1 id="hero-title">{x.home.hero.title} <em>{x.home.hero.emphasis}</em></h1>
      <p class="hero-lead">{x.home.hero.lead}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={route(locale, 'writing')}>{x.home.hero.primary}<span aria-hidden="true">→</span></a>
        <a class="button button-quiet" href={route(locale, 'oaf')}>{x.home.hero.secondary}<span aria-hidden="true">→</span></a>
      </div>
    </div>

    <figure class="decision-field" aria-labelledby="decision-field-caption">
      <div class="decision-field-grid" aria-hidden="true">
        <span class="field-line field-line-a"></span>
        <span class="field-line field-line-b"></span>
        <span class="field-line field-line-c"></span>
        <span class="field-line field-line-d"></span>
        <span class="field-node field-node-strategy">{locale === 'pl' ? 'strategia' : 'strategy'}</span>
        <span class="field-node field-node-architecture">{locale === 'pl' ? 'architektura' : 'architecture'}</span>
        <span class="field-node field-node-portfolio">{locale === 'pl' ? 'portfel' : 'portfolio'}</span>
        <span class="field-node field-node-execution">{locale === 'pl' ? 'wykonanie' : 'execution'}</span>
        <span class="field-center"><strong>{locale === 'pl' ? 'spójność' : 'coherence'}</strong><small>{locale === 'pl' ? 'punkt ciężkości' : 'center of gravity'}</small></span>
      </div>
      <figcaption id="decision-field-caption">{locale === 'pl' ? 'Wartość powstaje nie w pojedynczym obszarze, lecz w jakości relacji pomiędzy strategicznym kierunkiem, architekturą, alokacją i wykonaniem.' : 'Value is created not in a single domain, but in the quality of the relationships between strategic direction, architecture, allocation and execution.'}</figcaption>
    </figure>
  </section>

  <section class="section narrative-section problem-section" aria-labelledby="problem-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.home.problem.eyebrow}</p>
        <h2 id="problem-title">{x.home.problem.title}</h2>
      </div>
      <p class="content-lead">{x.home.problem.lead}</p>
    </div>
    <div class="tension-sequence">
      {x.home.problem.tensions.map((item) => (
        <article class="tension-row">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section evidence-section" aria-labelledby="evidence-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{x.home.evidence.eyebrow}</p>
      <h2 id="evidence-title">{x.home.evidence.title}</h2>
      <p class="content-lead">{x.home.evidence.lead}</p>
    </div>
    <div class="evidence-ledger">
      {x.evidence.map((item) => (
        <article class="evidence-note">
          <p class="evidence-value">{item.value}</p>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a href={item.href} target="_blank" rel="noopener noreferrer">{item.source}<span aria-hidden="true"> ↗</span><span class="sr-only"> — {c.externalNewTab}</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section thesis-section" aria-labelledby="thesis-title">
    <div class="thesis-statement">
      <p class="eyebrow">{x.home.thesis.eyebrow}</p>
      <h2 id="thesis-title">{x.home.thesis.title}</h2>
      <p>{x.home.thesis.lead}</p>
    </div>
    <ol class="decision-chain">
      {x.home.thesis.steps.map((item) => (
        <li><span aria-hidden="true"></span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>
      ))}
    </ol>
  </section>

  <section class="section section-oaf oaf-teaser" aria-labelledby="oaf-teaser-title">
    <div class="oaf-home-copy">
      <p class="eyebrow">{x.home.oaf.eyebrow}</p>
      <h2 id="oaf-teaser-title">{x.home.oaf.title}</h2>
      <p>{x.home.oaf.body}</p>
      <a class="text-link" href={route(locale, 'oaf')}>{x.home.oaf.cta}<span aria-hidden="true">→</span></a>
    </div>
    <OafDiagram locale={locale} id="home-oaf-diagram" compact />
  </section>

  <section class="section perspective-teaser" aria-labelledby="perspective-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.home.perspective.eyebrow}</p>
        <h2 id="perspective-title">{x.home.perspective.title}</h2>
      </div>
      <div>
        <p class="content-lead">{x.home.perspective.body}</p>
        <a class="text-link" href={route(locale, 'writing')}>{x.home.perspective.cta}<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="editorial-preview-list">
      {notes.map((note) => (
        <article>
          <p class="micro-label">{note.category} · {note.readTime} {ia.writing.min}</p>
          <h3><a href={noteHref(note.slug)}>{note.title}</a></h3>
          <p>{note.dek}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section practice-teaser" aria-labelledby="practice-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.home.practice.eyebrow}</p>
        <h2 id="practice-title">{x.home.practice.title}</h2>
      </div>
      <div>
        <p class="content-lead">{x.home.practice.body}</p>
        <a class="text-link" href={route(locale, 'work')}>{x.home.practice.cta}<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="interface-map">
      {x.practice.intersections.map((item) => (
        <article><h3>{item.title}</h3><p>{item.question}</p></article>
      ))}
    </div>
  </section>

  <section class="section author-teaser" aria-labelledby="author-title">
    <div>
      <p class="eyebrow">{x.home.author.eyebrow}</p>
      <h2 id="author-title">{x.home.author.title}</h2>
    </div>
    <div>
      <p class="content-lead">{x.home.author.body}</p>
      <a class="text-link" href={route(locale, 'about')}>{x.home.author.cta}<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section section-contact editorial-close" aria-labelledby="close-title">
    <div class="contact-copy">
      <p class="eyebrow">{x.home.close.eyebrow}</p>
      <h2 id="close-title">{x.home.close.title}</h2>
      <p>{x.home.close.body}</p>
    </div>
    <div class="contact-action contact-action-editorial">
      <a class="button button-primary button-large" href={route(locale, 'contact')}>{x.home.close.cta}<span aria-hidden="true">→</span></a>
      <a class="contact-secondary" href={site.linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> — {c.externalNewTab}</span></a>
    </div>
  </section>
</BaseLayout>
