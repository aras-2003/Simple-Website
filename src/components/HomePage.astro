---
import ProofStories from './ProofStories.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StartConversation from './StartConversation.astro';
import EnterpriseDecisionGraph from './EnterpriseDecisionGraph.astro';
import { home } from '../content/home';
import { journey } from '../content/journey';
import { route, type Locale } from '../lib/site';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const x=home[locale];
---
<BaseLayout locale={locale} routeKey="home" title={`Arkadiusz Kamrowski – ${x.title} ${x.emphasis}`} description={x.lead}>
 <section class="executive-hero executive-hero--graph" aria-labelledby="hero-title">
  <div class="executive-hero-copy"><p class="eyebrow">{x.audience}</p><h1 id="hero-title">{x.title} <em>{x.emphasis}</em></h1><p class="hero-lead">{x.lead}</p><div class="hero-actions"><a class="button button-primary" href={route(locale,'contact')}>{journey[locale].cta}<span aria-hidden="true">↗</span></a><a class="text-link" href={route(locale,'work')}>{x.advisory}</a></div></div>
  <EnterpriseDecisionGraph locale={locale} mode="hero" />
  <div class="signature-choices signature-choices--compact" aria-label={locale === 'pl' ? 'Trzy pytania: tak, nie, kto' : 'Three questions: yes, no, who'}>{x.signature.map(item => <span class="signature-choice"><strong>{item.word}</strong></span>)}</div>
 </section>
 <EnterpriseDecisionGraph locale={locale} mode="system" />
 <section class="section tension-section" aria-labelledby="tension-title"><h2 id="tension-title">{x.tensionsTitle}</h2><div class="tension-list">{x.tensions.map((item,index)=><article><span class="item-number" aria-hidden="true">0{index+1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
 <ProofStories locale={locale} compact/>
 <section class="section human-section" aria-labelledby="person-title"><img src="/assets/arkadiusz-kamrowski-square-v2.webp" alt="Arkadiusz Kamrowski" width="400" height="400" loading="lazy" decoding="async"/><div><p class="eyebrow">Arkadiusz Kamrowski</p><h2 id="person-title">{x.personTitle}</h2><p>{x.personBody}</p><p class="human-credential">MBA · {locale==='pl'?'Akademia Leona Koźmińskiego':'Kozminski University'} · Best Strategic Business Project</p><a class="text-link" href={route(locale,'about')}>{x.personLink}<span aria-hidden="true">↗</span></a></div></section>
 <StartConversation locale={locale}/>
 <aside class="method-note"><p>{x.method}</p><a class="text-link" href={route(locale,'oaf')}>{x.methodLink}</a></aside>
</BaseLayout>
<style is:global>
  .executive-hero--graph{grid-template-columns:minmax(0,1.02fr) minmax(0,1fr);column-gap:clamp(1.5rem,3vw,3rem);row-gap:0;padding-block:clamp(4.5rem,7vw,7rem) 2rem;min-height:660px;align-items:center}
  .executive-hero--graph .executive-hero-copy{align-self:center}
  .executive-hero--graph h1{max-width:15ch;font-size:clamp(3.4rem,5.6vw,6rem);line-height:1.02}
  .executive-hero--graph h1 em{font-style:italic}
  .executive-hero--graph .hero-lead{max-width:34rem;font-size:clamp(1.05rem,1.35vw,1.2rem)}
  .executive-hero--graph .edg-hero{align-self:center}
  .executive-hero--graph .signature-choices--compact{grid-column:1/-1;background:none;color:var(--green);padding:1rem 0 0;transform:none;box-shadow:none;display:flex;gap:clamp(1.2rem,3vw,3rem);flex-wrap:wrap;margin:2rem 0 0;border-top:1px solid var(--line)}
  .executive-hero--graph .signature-choices--compact .signature-choice{display:flex;align-items:baseline;gap:.6rem;border:0;padding:0;min-width:0}
  .executive-hero--graph .signature-choices--compact .signature-choice strong{font:700 11px/1.4 var(--sans);letter-spacing:.11em;color:var(--green)}
  .executive-hero--graph .signature-choices--compact .signature-choice:nth-child(2) strong{font-style:normal;color:var(--green)}
  @media(max-width:760px){.executive-hero--graph{grid-template-columns:minmax(0,1fr);min-height:0;gap:0;padding-block:3.4rem 2.5rem}.executive-hero--graph h1{font-size:clamp(3rem,10vw,4.8rem)}.executive-hero--graph .edg-hero{width:min(100%,440px);margin:2.5rem auto 0}.executive-hero--graph .signature-choices--compact{margin-top:1.5rem;gap:.9rem 1.5rem}}
</style>
