---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import ContactForm from './ContactForm.astro';
import { copy } from '../i18n/content';
import { ui } from '../content/ui';
import { contact } from '../content/contact';
import { route, site, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = copy[locale];
const content = contact[locale];
---
<BaseLayout locale={locale} routeKey="contact" title={content.title} description={content.description}>
  <PageHero eyebrow={content.eyebrow} headline={content.headline} lead={content.lead} />

  <section class="section contact-layout" aria-labelledby="contact-form-title">
    <aside class="contact-context">
      <p class="eyebrow">{content.contextEyebrow}</p>
      <h2>{content.contextTitle}</h2>
      <ul class="fit-list">{content.fit.map((item) => <li>{item}</li>)}</ul>
      <p class="contact-linkedin">{content.linkedin}</p>
      <a class="text-link" href={site.linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> – {c.externalNewTab}</span></a>
    </aside>
    <div class="contact-form-shell">
      <p class="eyebrow">{content.formEyebrow}</p>
      <h2 id="contact-form-title">{content.formTitle}</h2>
      <p>{content.formBody}</p>
      <ContactForm locale={locale} />
      <p class="privacy-inline">{content.privacy} <a href={route(locale, 'privacy')}>{ui[locale].nav.privacy}</a>.</p>
    </div>
  </section>
</BaseLayout>
