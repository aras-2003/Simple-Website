---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SectionLabel from './SectionLabel.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { getNotes } from '../content/notes';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = copy[locale].pages.writing;
const ia = editorial[locale].writing;
const notes = getNotes(locale);
const noteHref = (slug: string) => locale === 'pl' ? `/writing/${slug}` : `/en/writing/${slug}`;
---
<BaseLayout locale={locale} routeKey="writing" title={p.title} description={p.description}>
  <PageHero eyebrow={ia.label} headline={ia.title} lead={ia.body} />

  <section class="section writing-index" aria-labelledby="writing-index-title">
    <SectionLabel no="01" label={locale === 'pl' ? 'Najnowsze tezy' : 'Latest theses'} />
    <h2 id="writing-index-title" class="display-small">{locale === 'pl' ? 'Cztery teksty na początek.' : 'Four essays to start with.'}</h2>
    <div class="note-grid">
      {notes.map((note, index) => (
        <article class="note-card">
          <div class="note-meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{note.category}</span><span>{note.readTime} {ia.min}</span></div>
          <h3><a href={noteHref(note.slug)}>{note.title}</a></h3>
          <p>{note.dek}</p>
          <a class="text-link" href={noteHref(note.slug)}>{ia.read}<span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section writing-cta" aria-labelledby="writing-cta-title">
    <p class="eyebrow">Conversation</p>
    <h2 id="writing-cta-title">{locale === 'pl' ? 'Masz kontrargument albo podobny problem w praktyce?' : 'Have a counterargument or a similar problem in practice?'}</h2>
    <p>{locale === 'pl' ? 'Najbardziej interesują mnie rozmowy, które testują tezę na realnym kontekście organizacyjnym.' : 'I am most interested in conversations that test a thesis against real organizational context.'}</p>
    <a class="button button-primary" href={route(locale, 'contact')}>{editorial[locale].nav.contact}<span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
