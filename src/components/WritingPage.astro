---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import {perspective} from '../content/perspective';
import {getWriting,writingSlug} from '../content/writing';
import {route,type Locale} from '../lib/site';
interface Props {locale:Locale;} const {locale}=Astro.props;const x=perspective[locale];const [featured,...rest]=await getWriting(locale);const href=(note:NonNullable<typeof featured>)=>`${route(locale,'writing')}/${writingSlug(note)}`;
---
<BaseLayout locale={locale} routeKey="writing" title={`${locale==='pl'?'Perspektywa':'Perspective'} – Arkadiusz Kamrowski`} description={x.lead}>
<PageHero eyebrow={locale==='pl'?'Perspektywa':'Perspective'} headline={x.title} lead={x.lead}/>
{featured&&<section class="section featured-essay"><div><p class="eyebrow">{x.featured}</p><p class="micro-label">{featured.data.category}</p><span class="editorial-mark" aria-hidden="true">?</span></div><div><h2><a href={href(featured)}>{featured.data.title}</a></h2><p>{featured.data.dek}</p><a class="text-link" href={href(featured)}>{x.read}<span aria-hidden="true">↗</span></a></div></section>}
<section class="section perspective-library"><h2>{x.more}</h2><div class="editorial-library-list">{rest.map(note=><article><p class="eyebrow">{note.data.category}</p><h3><a href={href(note)}>{note.data.title}</a></h3><p>{note.data.dek}</p><a class="text-link" href={href(note)}>{x.read}<span aria-hidden="true">↗</span></a></article>)}</div></section>
</BaseLayout>
