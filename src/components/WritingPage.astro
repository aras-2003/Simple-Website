---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { editorial } from '../content/editorial';
import { getNotes } from '../content/notes';
import { vnext } from '../content/vnext';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ia = editorial[locale].writing;
const vx = vnext[locale];
const notes = getNotes(locale);
const perspectiveBase = route(locale, 'writing');
const noteHref = (slug: string) => `${perspectiveBase}/${slug}`;
const pageTitle = locale === 'pl' ? 'Perspektywa — Arkadiusz Kamrowski' : 'Perspective — Arkadiusz Kamrowski';
const pageDescription = locale === 'pl'
  ? 'Dane, benchmarki i tezy o architekturze organizacyjnej, strategii, transformacji, portfolio, governance, AI i wykonaniu.'
  : 'Evidence, benchmarks and theses on organizational architecture, strategy, transformation, portfolio, governance, AI and execution.';
---
<BaseLayout locale={locale} routeKey="writing" title={pageTitle} description={pageDescription}>
  <PageHero eyebrow={locale === 'pl' ? 'Perspektywa / dane, benchmarki, tezy' : 'Perspective / evidence, benchmarks, theses'} headline={ia.title} lead={ia.body} />

  <section class="section perspective-evidence" aria-labelledby="perspective-evidence-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{locale === 'pl' ? 'Dlaczego ten temat ma znaczenie' : 'Why this matters'}</p>
      <h2 id="perspective-evidence-title">{vx.home.perspectiveTitle}</h2>
      <p class="content-lead">{vx.home.perspectiveBody}</p>
    </div>
    <div class="evidence-grid evidence-grid-perspective">
      {vx.evidence.map((item) => (
        <article class="evidence-card">
          <p class="evidence-value">{item.value}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <a href={item.href} target="_blank" rel="noopener noreferrer">{item.source}<span aria-hidden="true"> ↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section perspective-thesis-section" aria-labelledby="perspective-theses-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{locale === 'pl' ? 'Tezy / do falsyfikacji, nie do podziwiania' : 'Theses / to falsify, not admire'}</p>
        <h2 id="perspective-theses-title">{locale === 'pl' ? 'Dane są początkiem rozmowy. Dalej trzeba postawić tezę i sprawdzić ją w praktyce.' : 'Evidence starts the conversation. Then a thesis has to survive contact with practice.'}</h2>
      </div>
      <p class="content-lead">{locale === 'pl' ? 'Każdy tekst poniżej łączy problem organizacyjny z hipotezą dotyczącą decyzji, architektury, portfela albo governance. Kolejny krok to uzupełnianie ich o coraz lepsze źródła, benchmarki i przykłady.' : 'Each essay connects an organizational problem to a hypothesis about decisions, architecture, portfolio or governance. The next step is to keep strengthening them with better evidence, benchmarks and cases.'}</p>
    </div>
    <div class="note-grid note-grid-vnext">
      {notes.map((note) => (
        <article class="note-card note-card-vnext">
          <div class="note-meta"><span>{note.category}</span><span>{note.readTime} {ia.min}</span></div>
          <h3><a href={noteHref(note.slug)}>{note.title}</a></h3>
          <p>{note.dek}</p>
          <a class="text-link" href={noteHref(note.slug)}>{ia.read}<span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section perspective-reference-section" aria-labelledby="perspective-reference-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{locale === 'pl' ? 'Punkty odniesienia' : 'Reference points'}</p>
      <h2 id="perspective-reference-title">{locale === 'pl' ? 'Perspektywa nie zaczyna się od OAF. OAF wynika z wcześniejszych szkół myślenia o organizacji.' : 'The perspective does not start with OAF. OAF follows from established schools of thought about organizations.'}</h2>
    </div>
    <div class="lineage-grid lineage-grid-light">
      {vx.lineage.map((item) => (
        <article>
          <p class="lineage-concept">{item.concept}</p>
          <h3>{item.author}</h3>
          <p>{item.contribution}</p>
          <a href={item.href} target="_blank" rel="noopener noreferrer">{locale === 'pl' ? 'Źródło' : 'Source'}<span aria-hidden="true"> ↗</span></a>
        </article>
      ))}
    </div>
    <div class="inline-actions">
      <a class="button button-primary" href={route(locale, 'oaf')}>{locale === 'pl' ? 'Zobacz, jak OAF składa te nurty' : 'See how OAF connects these threads'}<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section writing-cta" aria-labelledby="writing-cta-title">
    <p class="eyebrow">{locale === 'pl' ? 'Rozmowa' : 'Conversation'}</p>
    <h2 id="writing-cta-title">{locale === 'pl' ? 'Masz kontrargument, lepsze dane albo podobny problem w praktyce?' : 'Have a counterargument, better evidence or a similar problem in practice?'}</h2>
    <p>{locale === 'pl' ? 'Najbardziej interesują mnie rozmowy, które testują tezę na realnym kontekście organizacyjnym.' : 'I am most interested in conversations that test a thesis against real organizational context.'}</p>
    <a class="button button-primary" href={route(locale, 'contact')}>{editorial[locale].nav.contact}<span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
