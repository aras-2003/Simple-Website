---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { method, frameworkGroups } from '../content/method';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const x = method[locale];
const groups = frameworkGroups[locale];
const metaDescription = locale === 'pl'
  ? 'OAF: cztery pytania łączące kierunek, architekturę, priorytety i dowody. Model pracy z relacjami między strategią a wykonaniem.'
  : 'OAF: four questions connecting direction, architecture, priorities and evidence. A working model for the relationships between strategy and execution.';
const governance = locale === 'pl'
  ? {
      label: 'Zasada ładu architektonicznego',
      title: 'Lepsze decyzje. Szybciej.',
      quote: 'Celem ładu architektonicznego nie jest rozbudowywanie kontroli. Chodzi o lepsze decyzje podejmowane szybciej.',
      body: 'Szybciej nie znaczy z mniejszą dyscypliną. Dobrze zaprojektowany ład architektoniczny skraca czas oczekiwania, nie czas potrzebny na analizę: wskazuje właściciela, kryteria i granice wyjątku, a jednocześnie zostawia zespołom autonomię tam, gdzie decyzja może pozostać lokalna.',
      link: 'Przeczytaj perspektywę o architekturze',
    }
  : {
      label: 'Architecture governance principle',
      title: 'Better decisions. Faster.',
      quote: "The goal of architecture governance isn't more governance. It's better decisions made faster.",
      body: 'Faster does not mean less rigorous. Good governance reduces waiting, not thinking: it makes ownership, criteria and exception boundaries explicit while preserving team autonomy where a decision can remain local.',
      link: 'Read the architecture perspective',
    };
const governanceArticle = `${route(locale, 'writing')}/architecture-as-decision-system`;
---

<BaseLayout locale={locale} routeKey="oaf" title="OAF – Organizational Architecture Framework" description={metaDescription}>
  <PageHero eyebrow="OAF / Organizational Architecture Framework" headline={x.title} lead={x.lead} />

  <section class="section method-model" aria-labelledby="model-title">
    <h2 id="model-title">{x.modelTitle}</h2>
    <ol class="question-cycle">
      {x.questions.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ol>
    <p class="feedback-line"><span aria-hidden="true">↶</span>{x.feedback}</p>
  </section>

  <section class="section architecture-principle" aria-labelledby="architecture-principle-title">
    <div class="architecture-principle-heading">
      <p class="eyebrow">{governance.label}</p>
      <h2 id="architecture-principle-title">{governance.title}</h2>
    </div>
    <div class="architecture-principle-copy">
      <blockquote><p>{governance.quote}</p></blockquote>
      <p>{governance.body}</p>
      <a class="text-link" href={governanceArticle}>{governance.link}<span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section method-uses">
    <h2>{x.useTitle}</h2>
    <ul>{x.uses.map((item) => <li>{item}</li>)}</ul>
    <a class="button button-primary" href={route(locale, 'work')}>
      {locale === 'pl' ? 'Zobacz współpracę' : 'Explore advisory'}<span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="section method-foundations">
    <details>
      <summary>{x.boundaryLabel}</summary>
      <p>{x.boundary}</p>
    </details>

    <details>
      <summary>{x.sourceLabel}</summary>
      <p class="framework-intro">{x.frameworkIntro}</p>

      <div class="framework-groups">
        {groups.map((group, groupIndex) => (
          <section class="framework-group" aria-labelledby={`framework-group-${groupIndex}`}>
            <h3 id={`framework-group-${groupIndex}`}>{group.title}</h3>
            <div class="framework-relations">
              {group.items.map((item) => (
                <article class="framework-relation">
                  <h4><a href={item.href}>{item.label}<span aria-hidden="true"> ↗</span></a></h4>
                  <div class="framework-cell framework-focus">
                    <span class="micro-label">{x.frameworkFocusLabel}</span>
                    <p>{item.focus}</p>
                  </div>
                  <div class="framework-cell framework-oaf">
                    <span class="micro-label">{x.frameworkRelationLabel}</span>
                    <p>{item.relation}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </details>
  </section>
</BaseLayout>

<style is:global>
  .architecture-principle {
    display: grid;
    grid-template-columns: minmax(12rem, .72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .architecture-principle-heading h2 {
    max-width: 12ch;
  }

  .architecture-principle-copy {
    max-width: 44rem;
  }

  .architecture-principle-copy blockquote {
    margin: 0 0 1.25rem;
    padding: 0;
    border: 0;
  }

  .architecture-principle-copy blockquote p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    line-height: 1.16;
    letter-spacing: -.025em;
    color: var(--ink);
  }

  .architecture-principle-copy > p {
    max-width: 40rem;
    margin-bottom: 1.2rem;
  }

  .framework-intro {
    max-width: 54rem;
  }

  .framework-group {
    margin-top: 2.5rem;
  }

  .framework-group + .framework-group {
    margin-top: 3rem;
  }

  .framework-group > h3 {
    margin: 0 0 .8rem;
    font-family: var(--sans);
    font-size: .86rem;
    font-weight: 650;
    letter-spacing: .08em;
    line-height: 1.45;
    text-transform: uppercase;
    color: var(--green);
  }

  .framework-relation {
    display: grid;
    grid-template-columns: minmax(12rem, .8fr) 1fr 1.25fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }

  .framework-relation h4 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }

  .framework-relation h4 a {
    text-decoration-thickness: 1px;
  }

  .framework-cell .micro-label {
    display: block;
    margin-bottom: .35rem;
  }

  .method-foundations .framework-cell p {
    max-width: none;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }

  .framework-focus p {
    color: var(--muted);
  }

  .framework-oaf p {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .architecture-principle,
    .framework-relation {
      grid-template-columns: 1fr;
    }

    .architecture-principle {
      gap: 1.4rem;
    }

    .architecture-principle-heading h2 {
      max-width: none;
    }

    .framework-relation {
      gap: 1rem;
      padding: 1.4rem 0 1.6rem;
    }

    .framework-cell {
      max-width: 42rem;
    }
  }
</style>
