---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import {method, foundations} from '../content/method';
import {route,type Locale} from '../lib/site';
interface Props {locale:Locale;} const {locale}=Astro.props;const x=method[locale];
---
<BaseLayout locale={locale} routeKey="oaf" title="OAF – Organizational Architecture Framework" description={x.lead}>
<PageHero eyebrow="OAF / Organizational Architecture Framework" headline={x.title} lead={x.lead}/>
<section class="section method-model" aria-labelledby="model-title"><h2 id="model-title">{x.modelTitle}</h2><ol class="question-cycle">{x.questions.map(item=><li><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol><p class="feedback-line"><span aria-hidden="true">↶</span>{x.feedback}</p></section>
<section class="section method-uses"><h2>{x.useTitle}</h2><ul>{x.uses.map(item=><li>{item}</li>)}</ul><a class="button button-primary" href={route(locale,'work')}>{locale==='pl'?'Zobacz współpracę':'Explore advisory'}<span aria-hidden="true">↗</span></a></section>
<section class="section method-foundations"><details><summary>{x.boundaryLabel}</summary><p>{x.boundary}</p></details><details><summary>{x.sourceLabel}</summary><ul>{foundations.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></details></section>
</BaseLayout>
