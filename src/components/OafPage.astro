---
import BaseLayout from '../layouts/BaseLayout.astro';
import OafDiagram from './OafDiagram.astro';
import PageHero from './PageHero.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { platform, platformSources } from '../content/platform';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = copy[locale];
const ia = editorial[locale].oaf;
const x = platform[locale].oaf;
const pl = locale === 'pl';
const td = (value: string) => value.replaceAll('—', '–');
const lineage = pl ? [
  { author: 'Jay Galbraith', concept: 'Star Model', body: 'Strategia, struktura, procesy, systemy motywacyjne i ludzie jako współzależne dźwignie projektu organizacji.', href: platformSources.galbraith },
  { author: 'Peters, Waterman, Phillips / McKinsey', concept: '7-S', body: 'Struktura nie jest organizacją; strategia, systemy, umiejętności, ludzie, styl i wartości muszą się wzajemnie wspierać.', href: platformSources.mckinsey7s },
  { author: 'Richard Burton & Børge Obel', concept: 'Fit / misfit', body: 'Projekt organizacji jest problemem dopasowania między strategią, kontekstem, strukturą i koordynacją.', href: platformSources.burtonObel },
  { author: 'Jeanne Ross, Peter Weill & David Robertson', concept: 'Operating model + EA', body: 'Enterprise architecture jako organizująca logika procesów i IT wynikająca z operating modelu.', href: platformSources.mitCisrBook },
] : [
  { author: 'Jay Galbraith', concept: 'Star Model', body: 'Strategy, structure, processes, rewards and people as interdependent organization-design levers.', href: platformSources.galbraith },
  { author: 'Peters, Waterman, Phillips / McKinsey', concept: '7-S', body: 'Structure is not the organization; strategy, systems, skills, staff, style and values must reinforce one another.', href: platformSources.mckinsey7s },
  { author: 'Richard Burton & Børge Obel', concept: 'Fit / misfit', body: 'Organization design is a fit problem across strategy, context, structure and coordination.', href: platformSources.burtonObel },
  { author: 'Jeanne Ross, Peter Weill & David Robertson', concept: 'Operating model + EA', body: 'Enterprise architecture as the organizing logic of processes and IT derived from the operating model.', href: platformSources.mitCisrBook },
];
const pageTitle = 'OAF – Organizational Architecture Framework';
const pageDescription = pl
  ? 'OAF: prosty model łączący kierunek, architekturę, priorytety i dowody z wykonania w jedną pętlę decyzji.'
  : 'OAF: a simple model connecting direction, architecture, priorities and execution evidence into one decision loop.';
const hero = pl
  ? {
      eyebrow: 'OAF / model integrujący',
      title: 'Cztery pytania, które utrzymują strategię, inwestycje i wykonanie w jednej pętli.',
      lead: 'OAF nie jest nową metodyką do wdrożenia. To soczewka do rozmowy o tym, czy kierunek, model organizacji, architektura, portfel i dowody z wykonania prowadzą do tej samej decyzji.',
    }
  : {
      eyebrow: 'OAF / integrating model',
      title: 'Four questions that keep strategy, investment and execution inside one loop.',
      lead: 'OAF is not another methodology to implement. It is a lens for asking whether direction, organizational design, architecture, portfolio and execution evidence are driving the same decision.',
    };
---
<BaseLayout locale={locale} routeKey="oaf" title={pageTitle} description={pageDescription}>
  <PageHero eyebrow={hero.eyebrow} headline={hero.title} lead={hero.lead} />

  <section class="section oaf-executive-questions" aria-labelledby="oaf-questions-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{pl ? 'Model / cztery pytania executive' : 'Model / four executive questions'}</p>
        <h2 id="oaf-questions-title">{pl ? 'Zamiast zaczynać od diagramu, zacznij od decyzji, które muszą się ze sobą zgadzać.' : 'Instead of starting with a diagram, start with the decisions that must agree.'}</h2>
      </div>
      <p class="content-lead">{pl ? 'Każda warstwa ma własnego naturalnego właściciela. Problem pojawia się wtedy, gdy odpowiedzi powstają osobno i nikt nie posiada relacji pomiędzy nimi.' : 'Each layer has a natural owner. The problem appears when answers are produced separately and nobody owns the relationship between them.'}</p>
    </div>
    <div class="oaf-question-grid">
      {x.layers.map((layer, index) => (
        <article>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <p class="micro-label">{td(layer.title)}</p>
          <h3>{td(layer.question)}</h3>
          <p>{td(layer.body)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-oaf oaf-model-section oaf-model-section-executive" aria-labelledby="model-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(x.model.eyebrow)}</p>
        <h2 id="model-title">{td(x.model.title)}</h2>
      </div>
      <p class="content-lead">{td(x.model.body)}</p>
    </div>
    <OafDiagram locale={locale} id="oaf-page-diagram" />
  </section>

  <section class="section oaf-misfit-executive" aria-labelledby="misfit-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(x.misfit.eyebrow)}</p>
        <h2 id="misfit-title">{pl ? 'OAF zaczyna być użyteczny, gdy lokalnie poprawne decyzje przestają składać się w całość.' : 'OAF becomes useful when locally reasonable decisions stop adding up to a coherent whole.'}</h2>
      </div>
      <p class="content-lead">{pl ? 'To nie brak frameworka jest sygnałem. Sygnałem jest rozjazd pomiędzy deklarowanym kierunkiem, finansowaniem, architekturą i tym, co naprawdę może wykonać organizacja.' : 'The signal is not a missing framework. It is a mismatch between declared direction, funding, architecture and what the organization can actually execute.'}</p>
    </div>
    <div class="oaf-misfit-rail">
      {x.misfit.examples.map((item, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{td(item.title)}</h3>
          <p>{td(item.body)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section oaf-application-executive" aria-labelledby="uses-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{pl ? 'Zastosowanie / kiedy ma sens' : 'Application / when it helps'}</p>
        <h2 id="uses-title">{pl ? 'Nie każdy problem potrzebuje OAF. Te zwykle potrzebują perspektywy przekrojowej.' : 'Not every problem needs OAF. These usually need a cross-system view.'}</h2>
      </div>
      <p class="content-lead">{pl ? 'Wspólny mianownik to liczba zależności między kierunkiem, odpowiedzialnością, technologią, finansowaniem i wykonaniem — nie wielkość projektu.' : 'The common denominator is the number of dependencies across direction, accountability, technology, funding and execution — not project size.'}</p>
    </div>
    <div class="oaf-use-rail">
      {x.uses.map((item) => <article><h3>{td(item.title)}</h3><p>{td(item.body)}</p></article>)}
    </div>
    <div class="next-paths oaf-executive-actions">
      <a class="button button-primary" href={route(locale, 'work')}>{pl ? 'Zobacz współpracę' : 'See advisory'}<span aria-hidden="true">→</span></a>
      <a class="text-link" href={route(locale, 'contact')}>{pl ? 'Opisz konkretny problem' : 'Describe a concrete problem'}<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section oaf-reference-section" aria-labelledby="references-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{pl ? 'Zaplecze / bez udawania wynalezienia dyscypliny' : 'Foundations / without pretending to invent the field'}</p>
      <h2 id="references-title">{pl ? 'OAF stoi na istniejących szkołach myślenia i ma jasno określone granice.' : 'OAF stands on established schools of thought and keeps explicit boundaries.'}</h2>
    </div>

    <div class="oaf-reference-grid">
      <details>
        <summary>{pl ? 'Punkty odniesienia' : 'Reference points'} <span aria-hidden="true">＋</span></summary>
        <div class="oaf-reference-list">
          {lineage.map((item) => (
            <article>
              <p class="micro-label">{item.concept}</p>
              <h3>{item.author}</h3>
              <p>{td(item.body)}</p>
              <a href={item.href} target="_blank" rel="noopener noreferrer">{pl ? 'Źródło' : 'Source'}<span aria-hidden="true"> ↗</span><span class="sr-only"> – {c.externalNewTab}</span></a>
            </article>
          ))}
        </div>
      </details>

      <details>
        <summary>{pl ? 'Pryncypia jakości decyzji' : 'Decision-quality principles'} <span aria-hidden="true">＋</span></summary>
        <div class="oaf-reference-list">
          {ia.principles.map((rule) => <article><h3>{td(rule.title)}</h3><p>{td(rule.body)}</p></article>)}
        </div>
      </details>
    </div>

    <div class="oaf-boundary-strip">
      <p class="micro-label">{td(x.nonGoals.eyebrow)}</p>
      <p>{td(x.nonGoals.body)}</p>
      <ul>{x.nonGoals.items.map((item) => <li>{td(item)}</li>)}</ul>
    </div>
  </section>
</BaseLayout>
