---
import BaseLayout from '../layouts/BaseLayout.astro';
import OafDiagram from './OafDiagram.astro';
import PageHero from './PageHero.astro';
import SectionLabel from './SectionLabel.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = copy[locale].pages.oaf;
const ia = editorial[locale].oaf;
---
<BaseLayout locale={locale} routeKey="oaf" title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} headline={p.headline} lead={p.lead} />

  <section class="section section-oaf oaf-page" aria-labelledby="layers-title">
    <div class="oaf-page-intro">
      <div>
        <p class="eyebrow">Decision loop</p>
        <h2 id="layers-title">{ia.layersTitle}</h2>
      </div>
      <p>{ia.layersBody}</p>
    </div>
    <OafDiagram locale={locale} id="oaf-page-diagram" />
    <div class="oaf-layer-details">
      {ia.layerDetails.map((layer, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3 lang="en">{layer.title}</h3>
          <p class="layer-question">{layer.question}</p>
          <p>{layer.body}</p>
        </article>
      ))}
    </div>
    <p class="oaf-note">{p.note}</p>
  </section>

  <section class="section rules-section" aria-labelledby="rules-title">
    <SectionLabel no="05" label="OAF / principles" />
    <div class="content-split">
      <h2 id="rules-title">{ia.principlesTitle}</h2>
      <p class="content-lead">{ia.principlesLead}</p>
    </div>
    <div class="rule-card-grid">
      {ia.principles.map((rule, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3 lang="en">{rule.title}</h3>
          <p>{rule.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section oaf-use-section" aria-labelledby="uses-title">
    <p class="eyebrow">Application</p>
    <h2 id="uses-title">{ia.usesTitle}</h2>
    <div class="use-case-grid">
      {ia.uses.map((item) => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}
    </div>
    <div class="inline-actions">
      <a class="button button-primary" href={route(locale, 'contact')}>{p.cta}<span aria-hidden="true">→</span></a>
      <a class="text-link" href={route(locale, 'work')}>{editorial[locale].nav.work}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
