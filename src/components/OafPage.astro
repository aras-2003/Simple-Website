---
import BaseLayout from '../layouts/BaseLayout.astro';
import OafDiagram from './OafDiagram.astro';
import PageHero from './PageHero.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { oafOperatingModel } from '../content/oaf-operating-model';
import { platform, platformSources } from '../content/platform';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = copy[locale];
const ia = editorial[locale].oaf;
const x = platform[locale].oaf;
const operating = oafOperatingModel[locale];
const td = (value: string) => value.replaceAll('—', '–');
const lineage = locale === 'pl' ? [
  { author: 'Jay Galbraith', concept: 'Star Model', body: 'Strategia, struktura, procesy, systemy motywacyjne i ludzie jako współzależne dźwignie projektu organizacji. Punkt wyjścia: organizacja to znacznie więcej niż schemat organizacyjny.', href: platformSources.galbraith },
  { author: 'Peters, Waterman, Phillips / McKinsey', concept: '7-S', body: 'Struktura nie jest organizacją. Strategia, systemy, umiejętności, ludzie, styl zarządzania i wspólne wartości wzajemnie się wzmacniają albo blokują.', href: platformSources.mckinsey7s },
  { author: 'Richard Burton & Børge Obel', concept: 'Fit / misfit', body: 'Projekt organizacji jest problemem dopasowania między strategią, kontekstem, strukturą i mechanizmami koordynacji. Rozjazd jest sygnałem do przeprojektowania systemu.', href: platformSources.burtonObel },
  { author: 'Jeanne Ross, Peter Weill & David Robertson', concept: 'Operating model + enterprise architecture', body: 'MIT CISR opisuje enterprise architecture jako organizującą logikę procesów i zdolności IT wynikającą z operating modelu – ważny most między strategią a fundamentem wykonania.', href: platformSources.mitCisrBook },
] : [
  { author: 'Jay Galbraith', concept: 'Star Model', body: 'Strategy, structure, processes, rewards and people as interdependent organization-design levers. The starting point: an organization is much more than an org chart.', href: platformSources.galbraith },
  { author: 'Peters, Waterman, Phillips / McKinsey', concept: '7-S', body: 'Structure is not organization. Strategy, systems, skills, staff, style and shared values can reinforce or constrain one another.', href: platformSources.mckinsey7s },
  { author: 'Richard Burton & Børge Obel', concept: 'Fit / misfit', body: 'Organization design is a problem of fit across strategy, context, structure and coordination mechanisms. Misfit is a signal to redesign the system.', href: platformSources.burtonObel },
  { author: 'Jeanne Ross, Peter Weill & David Robertson', concept: 'Operating model + enterprise architecture', body: 'MIT CISR frames enterprise architecture as the organizing logic of processes and IT capabilities derived from the operating model – a bridge between strategy and execution foundations.', href: platformSources.mitCisrBook },
];
const pageTitle = 'OAF – Organizational Architecture Framework';
const pageDescription = locale === 'pl'
  ? 'OAF jako rozwijana synteza projektowania organizacji, architektury korporacyjnej, portfela, ładu decyzyjnego i dowodów w jednej pętli decyzji.'
  : 'OAF as an evolving synthesis of organization design, enterprise architecture, portfolio, governance and evidence in one decision loop.';
---
<BaseLayout locale={locale} routeKey="oaf" title={pageTitle} description={pageDescription}>
  <PageHero eyebrow={td(x.hero.eyebrow)} headline={td(x.hero.title)} lead={td(x.hero.lead)} />

  <section class="section oaf-definition" aria-labelledby="oaf-definition-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(x.definition.eyebrow)}</p>
        <h2 id="oaf-definition-title">{td(x.definition.title)}</h2>
      </div>
      <div class="definition-copy">
        <p>{td(x.definition.body)}</p>
        <p class="definition-emphasis">{td(x.definition.oaf)}</p>
      </div>
    </div>
  </section>

  <section class="section lineage-section" aria-labelledby="lineage-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{locale === 'pl' ? 'Punkty odniesienia / skąd bierze się systemowe myślenie' : 'Reference points / where systems thinking comes from'}</p>
      <h2 id="lineage-title">{td(x.lineageTitle)}</h2>
      <p class="content-lead">{td(x.lineageLead)}</p>
    </div>
    <div class="lineage-river">
      {lineage.map((item) => (
        <article>
          <div class="lineage-marker" aria-hidden="true"></div>
          <p class="micro-label">{item.concept}</p>
          <h3>{item.author}</h3>
          <p>{td(item.body)}</p>
          <a href={item.href} target="_blank" rel="noopener noreferrer">{locale === 'pl' ? 'Źródło' : 'Source'}<span aria-hidden="true"> ↗</span><span class="sr-only"> – {c.externalNewTab}</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section convergence-section" aria-labelledby="gap-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(x.gap.eyebrow)}</p>
        <h2 id="gap-title">{td(x.gap.title)}</h2>
      </div>
      <p class="content-lead">{td(x.gap.conclusion)}</p>
    </div>
    <div class="convergence-map" aria-label={locale === 'pl' ? 'Cztery nurty zbieżne w jednej pętli decyzji' : 'Four streams converging into one decision loop'}>
      {x.gap.streams.map((item) => (
        <article><h3>{td(item.title)}</h3><p>{td(item.body)}</p></article>
      ))}
      <div class="convergence-core"><span>OAF</span><strong>{locale === 'pl' ? 'interfejsy decyzji' : 'decision interfaces'}</strong></div>
    </div>
  </section>

  <section class="section oaf-model-section" aria-labelledby="model-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(x.model.eyebrow)}</p>
        <h2 id="model-title">{td(x.model.title)}</h2>
      </div>
      <p class="content-lead">{td(x.model.body)}</p>
    </div>
    <OafDiagram locale={locale} id="oaf-page-diagram" />
  </section>

  <section class="section layer-deep-dive" aria-labelledby="layers-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{locale === 'pl' ? 'Od modelu do decyzji' : 'From model to decision'}</p>
      <h2 id="layers-title">{locale === 'pl' ? 'Każdy wymiar odpowiada na inne pytanie – razem tworzą jedną pętlę.' : 'Each dimension answers a different question – together they form one loop.'}</h2>
    </div>
    <div class="layer-editorial-list">
      {x.layers.map((layer) => (
        <article>
          <p class="layer-name">{td(layer.title)}</p>
          <h3>{td(layer.question)}</h3>
          <p>{td(layer.body)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section misfit-section" aria-labelledby="misfit-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(x.misfit.eyebrow)}</p>
        <h2 id="misfit-title">{td(x.misfit.title)}</h2>
      </div>
      <p class="content-lead">{locale === 'pl' ? 'To właśnie rozjazd – nie brak diagramu – jest sygnałem, że architektura organizacyjna wymaga interwencji.' : 'Misfit – not a missing diagram – is the signal that organizational architecture needs intervention.'}</p>
    </div>
    <div class="misfit-grid">
      {x.misfit.examples.map((item) => <article><h3>{td(item.title)}</h3><p>{td(item.body)}</p></article>)}
    </div>
  </section>

  <section class="section layer-deep-dive decision-contract-section" aria-labelledby="decision-contract-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(operating.eyebrow)}</p>
        <h2 id="decision-contract-title">{td(operating.title)}</h2>
      </div>
      <p class="content-lead">{td(operating.lead)}</p>
    </div>
    <div class="layer-editorial-list decision-contract-list">
      {operating.items.map((item) => (
        <article>
          <p class="layer-name">{td(item.title)}</p>
          <h3>{td(item.question)}</h3>
          <p>{td(item.body)}</p>
        </article>
      ))}
    </div>
    <p class="content-lead decision-contract-summary">{td(operating.summary)}</p>
  </section>

  <section class="section principles-section" aria-labelledby="principles-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{locale === 'pl' ? 'Pryncypia / standard jakości' : 'Principles / quality standard'}</p>
        <h2 id="principles-title">{td(ia.principlesTitle)}</h2>
      </div>
      <p class="content-lead">{td(ia.principlesLead)}</p>
    </div>
    <div class="principle-strips">
      {ia.principles.map((rule) => <article><h3>{td(rule.title)}</h3><p>{td(rule.body)}</p></article>)}
    </div>
  </section>

  <section class="section boundaries-section" aria-labelledby="boundaries-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{td(x.nonGoals.eyebrow)}</p>
        <h2 id="boundaries-title">{td(x.nonGoals.title)}</h2>
      </div>
      <div>
        <p class="content-lead">{td(x.nonGoals.body)}</p>
        <ul class="boundary-list">{x.nonGoals.items.map((item) => <li>{td(item)}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section oaf-use-section oaf-use-section-polished" aria-labelledby="uses-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{locale === 'pl' ? 'Zastosowanie / kiedy model zarabia na swoje miejsce' : 'Application / when the model earns its place'}</p>
        <h2 id="uses-title">{locale === 'pl' ? 'Nie każdy problem potrzebuje OAF. Te sytuacje zwykle potrzebują perspektywy przekrojowej.' : 'Not every problem needs OAF. These situations usually need a cross-system view.'}</h2>
      </div>
      <p class="content-lead">{locale === 'pl' ? 'Wspólny mianownik to nie skala projektu, lecz liczba zależności pomiędzy kierunkiem, odpowiedzialnością, technologią, finansowaniem i wykonaniem.' : 'The common denominator is not project size but the number of dependencies across direction, accountability, technology, funding and execution.'}</p>
    </div>
    <div class="use-case-editorial use-case-editorial-polished">
      {x.uses.map((item) => <article><h3>{td(item.title)}</h3><p>{td(item.body)}</p></article>)}
    </div>
    <div class="next-paths oaf-use-actions">
      <a class="button button-primary" href={route(locale, 'work')}>{locale === 'pl' ? 'Zobacz praktykę' : 'See practice'}<span aria-hidden="true">→</span></a>
      <a class="text-link" href={route(locale, 'writing')}>{locale === 'pl' ? 'Wróć do danych i tez' : 'Back to evidence and theses'}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
