---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { vnext } from '../content/vnext';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = copy[locale].pages.work;
const ia = editorial[locale].work;
const vx = vnext[locale];
---
<BaseLayout locale={locale} routeKey="work" title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} headline={p.headline} lead={p.lead} />

  <section class="section practice-intro" aria-labelledby="practice-intro-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{locale === 'pl' ? 'Praktyka / cztery perspektywy' : 'Practice / four perspectives'}</p>
        <h2 id="practice-intro-title">{ia.introTitle}</h2>
      </div>
      <p class="content-lead">{ia.introBody}</p>
    </div>
  </section>

  <section class="section practice-grid practice-grid-vnext" aria-label={locale === 'pl' ? 'Obszary praktyki' : 'Practice areas'}>
    {ia.areas.map((item) => (
      <article class="practice-card practice-card-vnext">
        <p class="practice-promise">{item.promise}</p>
        <h2>{item.title}</h2>
        <p>{item.body}</p>
        <div class="practice-questions">
          <p class="micro-label">{locale === 'pl' ? 'Pytania, które warto zadać' : 'Questions worth asking'}</p>
          <ul>{item.questions.map((q) => <li>{q}</li>)}</ul>
        </div>
        <p class="practice-output">{item.outputs}</p>
      </article>
    ))}
  </section>

  <section class="section intersection-section intersection-section-vnext" aria-labelledby="intersections-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{locale === 'pl' ? 'Połączenia / tam powstaje dźwignia' : 'Connections / where leverage appears'}</p>
      <h2 id="intersections-title">{ia.intersectionsTitle}</h2>
      <p class="content-lead">{locale === 'pl' ? 'Każde z poniższych połączeń jest miejscem, w którym lokalnie poprawna decyzja może popsuć cały system. Dlatego wartość nie bierze się z doskonałości jednej funkcji, tylko z jakości interfejsów między nimi.' : 'Each connection below is a place where a locally correct decision can damage the whole system. Value comes less from optimizing one function and more from the quality of the interfaces between them.'}</p>
    </div>
    <div class="intersection-grid intersection-grid-vnext">
      {vx.intersections.map((item) => (
        <article>
          <p class="intersection-pair">{item.title}</p>
          <h3>{item.question}</h3>
          <p>{item.body}</p>
          <p class="intersection-signal">{item.misfit}</p>
        </article>
      ))}
    </div>
    <div class="inline-actions">
      <a class="button button-primary" href={route(locale, 'contact')}>{editorial[locale].nav.contact}<span aria-hidden="true">→</span></a>
      <a class="text-link" href={route(locale, 'oaf')}>{p.cta}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
