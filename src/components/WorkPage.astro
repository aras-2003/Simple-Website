---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { editorial } from '../content/editorial';
import { platform } from '../content/platform';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const ia = editorial[locale];
const x = platform[locale].practice;
const pageTitle = locale === 'pl' ? 'Praktyka — interfejsy decyzji i zastosowanie' : 'Practice — decision interfaces and application';
const pageDescription = locale === 'pl'
  ? 'Praktyka na styku strategii, architektury, portfela, PMO, AI i wykonania — przez konkretne miejsca rozjazdu w organizacji.'
  : 'Practice across strategy, architecture, portfolio, PMO, AI and execution — framed through concrete points of organizational misfit.';
---
<BaseLayout locale={locale} routeKey="work" title={pageTitle} description={pageDescription}>
  <PageHero eyebrow={x.hero.eyebrow} headline={x.hero.title} lead={x.hero.lead} />

  <section class="section practice-interface-section" aria-labelledby="interfaces-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{locale === 'pl' ? 'Punkty styku / gdzie znika spójność' : 'Interfaces / where coherence is lost'}</p>
      <h2 id="interfaces-title">{x.intersectionsTitle}</h2>
    </div>
    <div class="interface-deep-list">
      {x.intersections.map((item) => (
        <article>
          <div class="interface-title"><p class="micro-label">{item.title}</p><h3>{item.question}</h3></div>
          <div class="interface-detail"><p>{item.problem}</p><p class="interface-signal">{item.signal}</p><p class="interface-decision">{item.decision}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section toolbox-section" aria-labelledby="toolbox-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.toolbox.eyebrow}</p>
        <h2 id="toolbox-title">{x.toolbox.title}</h2>
      </div>
      <p class="content-lead">{locale === 'pl' ? 'Dopiero po zlokalizowaniu problemu ma sens wybór dyscypliny i artefaktu. Ten porządek chroni przed projektowaniem rozwiązania pod ulubione narzędzie.' : 'Only after locating the problem does it make sense to choose a discipline and artifact. This sequence protects against designing the problem around a preferred tool.'}</p>
    </div>
    <div class="toolbox-grid">
      {x.toolbox.items.map((item) => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}
    </div>
  </section>

  <section class="section operating-method-section" aria-labelledby="method-title">
    <div class="section-intro section-intro-wide">
      <p class="eyebrow">{x.method.eyebrow}</p>
      <h2 id="method-title">{x.method.title}</h2>
    </div>
    <ol class="operating-method">
      {x.method.steps.map((step) => (
        <li><div class="method-marker" aria-hidden="true"></div><div><h3>{step.title}</h3><p>{step.body}</p></div></li>
      ))}
    </ol>
  </section>

  <section class="section context-section" aria-labelledby="contexts-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.contexts.eyebrow}</p>
        <h2 id="contexts-title">{x.contexts.title}</h2>
      </div>
      <ul class="context-list">{x.contexts.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section practice-proof-note" aria-labelledby="proof-note-title">
    <div>
      <p class="eyebrow">{locale === 'pl' ? 'Dowody / bez marketingowej fikcji' : 'Evidence / no marketing fiction'}</p>
      <h2 id="proof-note-title">{locale === 'pl' ? 'Studia przypadków mają sens dopiero wtedy, gdy można uczciwie pokazać kontekst, decyzję i rezultat.' : 'Case studies matter only when context, decision and outcome can be shown honestly.'}</h2>
    </div>
    <p class="content-lead">{locale === 'pl' ? 'Nie publikuję fikcyjnych historii ani pozornych KPI. Anonimizowane przypadki pojawią się wtedy, gdy zakres publikacji będzie bezpieczny i merytorycznie użyteczny.' : 'I do not publish invented stories or cosmetic KPIs. Anonymized cases will appear when the publication scope is both safe and substantively useful.'}</p>
  </section>

  <section class="section next-path-section" aria-labelledby="practice-next-title">
    <div>
      <p class="eyebrow">{locale === 'pl' ? 'Dalej' : 'Next'}</p>
      <h2 id="practice-next-title">{locale === 'pl' ? 'Chcesz zobaczyć model systemowy czy źródło tej perspektywy?' : 'Want to see the system model or the source of this perspective?'}</h2>
    </div>
    <div class="next-paths">
      <a class="button button-primary" href={route(locale, 'oaf')}>OAF<span aria-hidden="true">→</span></a>
      <a class="text-link" href={route(locale, 'about')}>{ia.nav.about}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
