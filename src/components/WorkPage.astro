---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import DecisionArchitectureDelta from './DecisionArchitectureDelta.astro';
import PortfolioTradeoffMatrix from './PortfolioTradeoffMatrix.astro';
import CaseProofBlueprint from './CaseProofBlueprint.astro';
import { caseStudies } from '../content/case-studies';
import { executive } from '../content/executive';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const x = executive[locale].work;
const pl = locale === 'pl';
const proofCases = [
  { item: caseStudies[locale][2]!, mode: 'portfolio' as const },
  { item: caseStudies[locale][3]!, mode: 'impact' as const },
  { item: caseStudies[locale][4]!, mode: 'governance' as const },
];
const pageTitle = pl ? 'Współpraca – executive advisory i architektura decyzji' : 'Advisory – executive decision architecture';
const pageDescription = pl
  ? 'Współpraca z CEO, CIO i liderami transformacji: diagnoza systemu decyzji, operating model, architektura, portfel, governance i roadmapa wykonania.'
  : 'Advisory for CEOs, CIOs and transformation leaders across decision diagnostics, operating model, architecture, portfolio, governance and execution roadmap.';
---
<BaseLayout locale={locale} routeKey="work" title={pageTitle} description={pageDescription}>
  <PageHero eyebrow={x.hero.eyebrow} headline={x.hero.title} lead={x.hero.lead} />

  <section class="section engagement-section" aria-labelledby="engagements-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.engagements.eyebrow}</p>
        <h2 id="engagements-title">{x.engagements.title}</h2>
      </div>
      <DecisionArchitectureDelta locale={locale} />
    </div>
    <div class="engagement-grid">
      {x.engagements.items.map((item, index) => (
        <article>
          <div class="engagement-index"><span>{String(index + 1).padStart(2, '0')}</span><p class="micro-label">{item.label}</p></div>
          <h3>{item.title}</h3>
          <p class="engagement-when">{item.when}</p>
          <ul>{item.outputs.map((output) => <li>{output}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section advisory-canvas-section" aria-labelledby="decision-canvas-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{pl ? 'Przykład artefaktu / decyzja portfelowa' : 'Example artifact / portfolio decision'}</p>
        <h2 id="decision-canvas-title">{pl ? 'Kompromis powinien być widoczny na jednej planszy — nie ukryty w pięciu deckach.' : 'A trade-off should be visible on one canvas — not hidden across five decks.'}</h2>
      </div>
      <p class="content-lead">{pl ? 'Poniżej nie ma „gotowej macierzy do wdrożenia”. To przykład, jak rezultat pracy może materializować decyzję: pokazać wartość, zależności i capacity w formie, która prowadzi do stop / merge / sequence / continue.' : 'This is not a ready-made matrix to implement. It shows how an engagement output can materialize a decision: make value, dependencies and capacity visible enough to drive stop / merge / sequence / continue.'}</p>
    </div>
    <PortfolioTradeoffMatrix locale={locale} />
  </section>

  <section class="section advisory-domains-section" aria-labelledby="domains-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.domains.eyebrow}</p>
        <h2 id="domains-title">{x.domains.title}</h2>
      </div>
      <p class="content-lead">{pl ? 'To połączenie jest kluczowe: CEO nie potrzebuje pięciu niezależnych diagnoz, a CIO nie powinien tłumaczyć strategii na architekturę w próżni organizacyjnej.' : 'The connection matters: a CEO does not need five independent diagnostics, and a CIO should not translate strategy into architecture inside an organizational vacuum.'}</p>
    </div>
    <div class="advisory-domain-grid">
      {x.domains.items.map((item, index) => (
        <article>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section case-study-section executive-case-study-section" aria-labelledby="case-studies-title">
    <div class="section-intro section-intro-split">
      <div>
        <p class="eyebrow">{x.cases.eyebrow}</p>
        <h2 id="case-studies-title">{pl ? 'Wybrane przypadki pokazuję jako logikę decyzji — nie katalog osiągnięć.' : 'Selected cases are shown as decision logic — not an achievement catalogue.'}</h2>
      </div>
      <p class="content-lead">{pl ? 'Przykłady są anonimizowane i schematyczne. Nie pokazuję nazw klientów ani dopisanych KPI. Pokazuję kontekst, problem, interwencję i to, jak zmienia się mechanizm podejmowania decyzji.' : 'Examples are anonymized and schematic. I do not publish client names or invented KPI. I show context, challenge, intervention and how the decision mechanism changes.'}</p>
    </div>
    <div class="case-study-list compact-case-study-list">
      {proofCases.map(({ item, mode }, index) => <CaseProofBlueprint locale={locale} item={item} mode={mode} index={index} />)}
    </div>
  </section>

  <section class="section advisory-close" aria-labelledby="advisory-close-title">
    <div>
      <p class="eyebrow">{pl ? 'Dalej' : 'Next'}</p>
      <h2 id="advisory-close-title">{x.close.title}</h2>
      <p class="content-lead">{x.close.body}</p>
    </div>
    <div class="next-paths">
      <a class="button button-primary button-large" href={route(locale, 'contact')}>{x.close.cta}<span aria-hidden="true">→</span></a>
      <a class="text-link" href={route(locale, 'oaf')}>{pl ? 'Zobacz metodę OAF' : 'See the OAF method'}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
