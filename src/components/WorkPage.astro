---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SectionLabel from './SectionLabel.astro';
import { copy } from '../i18n/content';
import { editorial } from '../content/editorial';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = copy[locale].pages.work;
const ia = editorial[locale].work;
const intersections = locale === 'pl' ? [
  {
    title: 'Strategia ↔ Architektura',
    question: 'Czy docelowy model organizacji i technologii naprawdę umożliwia kierunek strategiczny?',
    body: 'Strategia określa, co ma się zmienić; architektura przekłada to na zdolności, granice i decyzje projektowe. Wartość powstaje wtedy, gdy stan docelowy jest konsekwencją wyborów strategicznych, a nie równoległym obrazkiem.',
    signal: 'Sygnał rozjazdu: roadmapa architektoniczna może być zrealizowana bez widocznego wpływu na rezultat strategiczny.',
  },
  {
    title: 'Architektura ↔ Portfel',
    question: 'Czy zależności i decyzje architektoniczne zmieniają kolejność inwestycji?',
    body: 'Architektura pokazuje sekwencję i zależności między zdolnościami, platformami, danymi i zmianami organizacyjnymi. Portfel powinien tę logikę finansować, zamiast traktować inicjatywy jako niezależne pozycje.',
    signal: 'Sygnał rozjazdu: finansujemy projekty, których wartość zależy od niezaadresowanych fundamentów lub wspólnych zdolności.',
  },
  {
    title: 'Portfel ↔ Wykonanie',
    question: 'Czy priorytety są możliwe do wykonania przy realnych ograniczeniach organizacji?',
    body: 'Portfel jest deklaracją wyboru, ale wykonanie pokazuje realną przepustowość, zależności i koszt przełączania uwagi. Ograniczenie pracy w toku i jawne decyzje stop/start/continue są częścią strategii wykonania.',
    signal: 'Sygnał rozjazdu: wszystko jest priorytetem, a opóźnienia tłumaczymy wyłącznie wydajnością zespołów.',
  },
  {
    title: 'Wykonanie ↔ Strategia',
    question: 'Czy dowody z wykonania mają prawo zmienić wcześniejsze założenia?',
    body: 'Wykonanie nie jest końcem procesu. Dostarcza danych o zachowaniach użytkowników, ryzyku, kosztach i realnej wartości. Dojrzały system decyzji potrafi na tej podstawie zmienić kierunek lub wycofać wcześniejszy wybór.',
    signal: 'Sygnał rozjazdu: governance chroni plan przed faktami zamiast używać faktów do poprawy planu.',
  },
] : [
  {
    title: 'Strategy ↔ Architecture',
    question: 'Does the target organization and technology model actually enable the strategic direction?',
    body: 'Strategy defines what needs to change; architecture translates it into capabilities, boundaries and design choices. Value appears when the target state is a consequence of strategic choices, not a parallel picture.',
    signal: 'Misalignment signal: the architecture roadmap can be completed without a visible effect on the strategic outcome.',
  },
  {
    title: 'Architecture ↔ Portfolio',
    question: 'Do architectural dependencies change investment sequence?',
    body: 'Architecture exposes sequencing and dependencies across capabilities, platforms, data and organizational change. The portfolio should fund that logic rather than treat initiatives as independent line items.',
    signal: 'Misalignment signal: projects are funded even though their value depends on missing foundations or shared capabilities.',
  },
  {
    title: 'Portfolio ↔ Delivery',
    question: 'Are priorities executable within the organization’s real constraints?',
    body: 'Portfolio is a declaration of choice, while delivery exposes actual capacity, dependencies and switching cost. Limiting work in progress and making explicit stop/start/continue decisions are part of execution strategy.',
    signal: 'Misalignment signal: everything is a priority and delays are explained only as a team productivity issue.',
  },
  {
    title: 'Delivery ↔ Strategy',
    question: 'Can evidence from execution change an earlier assumption?',
    body: 'Execution is not the end of the process. It produces evidence about user behavior, risk, cost and realized value. A mature decision system can use that evidence to change direction or reverse an earlier choice.',
    signal: 'Misalignment signal: governance protects the plan from facts instead of using facts to improve the plan.',
  },
];
---
<BaseLayout locale={locale} routeKey="work" title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} headline={p.headline} lead={p.lead} />

  <section class="section practice-intro" aria-labelledby="practice-intro-title">
    <SectionLabel no="01" label={editorial[locale].nav.work} />
    <div class="content-split">
      <h2 id="practice-intro-title">{ia.introTitle}</h2>
      <p class="content-lead">{ia.introBody}</p>
    </div>
  </section>

  <section class="section practice-grid practice-grid-editorial" aria-label={locale === 'pl' ? 'Obszary praktyki' : 'Practice areas'}>
    {ia.areas.map((item, index) => (
      <article class="practice-card">
        <div class="practice-card-head">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><h2>{item.title}</h2><p class="practice-promise">{item.promise}</p></div>
        </div>
        <p>{item.body}</p>
        <div class="practice-questions">
          <p class="micro-label">{locale === 'pl' ? 'Pytania' : 'Questions'}</p>
          <ul>{item.questions.map((q) => <li>{q}</li>)}</ul>
        </div>
        <p class="practice-output">{item.outputs}</p>
      </article>
    ))}
  </section>

  <section class="section intersection-section" aria-labelledby="intersections-title">
    <p class="eyebrow">{locale === 'pl' ? 'Połączenia między obszarami' : 'Cross-system leverage'}</p>
    <h2 id="intersections-title">{ia.intersectionsTitle}</h2>
    <p class="intersection-intro">{locale === 'pl' ? 'Każde z poniższych połączeń jest miejscem, w którym lokalnie poprawna decyzja może popsuć cały system. Dlatego nie wystarczy zarządzać czterema domenami osobno.' : 'Each connection below is a place where a locally correct decision can damage the whole system. Managing the four domains separately is not enough.'}</p>
    <div class="intersection-grid">
      {intersections.map((item, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p class="intersection-question">{item.question}</p>
          <p>{item.body}</p>
          <p class="intersection-signal">{item.signal}</p>
        </article>
      ))}
    </div>
    <div class="inline-actions">
      <a class="button button-primary" href={route(locale, 'contact')}>{editorial[locale].nav.contact}<span aria-hidden="true">→</span></a>
      <a class="text-link" href={route(locale, 'oaf')}>{p.cta}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
