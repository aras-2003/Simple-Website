---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { copy } from '../i18n/content';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = copy[locale].pages.work;
---
<BaseLayout locale={locale} routeKey="work" title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} headline={p.headline} lead={p.lead} />
  <section class="section work-page-list" aria-label={locale === 'pl' ? 'Obszary pracy' : 'Focus areas'}>
    {p.items.map((item, index) => (
      <article><span>{String(index + 1).padStart(2, '0')}</span><h2 lang="en">{item.title}</h2><p>{item.body}</p></article>
    ))}
  </section>
  <section class="section evidence-section" aria-labelledby="evidence-title">
    <p class="eyebrow">Evidence</p>
    <h2 id="evidence-title">{p.evidenceTitle}</h2>
    <p>{p.evidenceBody}</p>
    <a class="button button-primary" href={route(locale, 'oaf')}>{p.cta}<span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
