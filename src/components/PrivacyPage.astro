---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { editorial } from '../content/editorial';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = editorial[locale].privacy;
const td = (value: string) => value.replaceAll('—', '–');
const pl = locale === 'pl';
const sections = pl ? [
  {
    title: 'Administrator danych',
    body: 'Administratorem danych przekazywanych przez formularz jest Arkadiusz Kamrowski. W sprawach dotyczących danych możesz skontaktować się przez formularz kontaktowy na tej stronie. Formularz służy wyłącznie do korespondencji związanej z wiadomością, którą inicjujesz.',
  },
  {
    title: 'Zakres danych',
    body: 'Przetwarzane są: imię i nazwisko, adres e-mail, opcjonalna organizacja, wybrany temat i treść wiadomości. Dla ochrony formularza przed nadużyciami przetwarzane są również podstawowe dane techniczne, w szczególności adres IP, origin żądania i informacje niezbędne do limitowania prób.',
  },
  {
    title: 'Cel i podstawa prawna',
    body: 'Dane są używane do odebrania wiadomości, prowadzenia korespondencji i ochrony formularza. Podstawą jest prawnie uzasadniony interes polegający na obsłudze korespondencji i bezpieczeństwie serwisu (art. 6 ust. 1 lit. f RODO), a gdy kontakt zmierza do zawarcia lub wykonania umowy – działania na żądanie osoby przed zawarciem umowy lub wykonanie umowy (art. 6 ust. 1 lit. b RODO). Checkbox w formularzu potwierdza zapoznanie się z informacją o prywatności; nie jest zgodą marketingową.',
  },
  {
    title: 'Odbiorcy i procesorzy',
    body: 'Dane mogą być powierzane dostawcom niezbędnym do działania strony i poczty: usłudze transactional email Resend, dostawcy hostingu/infrastruktury oraz operatorowi skrzynki pocztowej. Nie są sprzedawane ani przekazywane do sieci reklamowych, newslettera lub automatycznego CRM.',
  },
  {
    title: 'Transfer poza EOG',
    body: 'Resend informuje, że jego podstawowe operacje przetwarzania i przechowywanie danych klientów odbywają się w Stanach Zjednoczonych. Transfery z EOG są objęte Standardowymi Klauzulami Umownymi w DPA Resend oraz dodatkowo mechanizmem EU–U.S. Data Privacy Framework. Aktualne warunki dostawcy są dostępne w dokumentacji Resend.',
  },
  {
    title: 'Retencja',
    body: 'Aplikacja formularza nie tworzy własnej bazy zgłoszeń. Wiadomość pozostaje w systemach pocztowych tylko przez okres potrzebny do obsługi korespondencji, a następnie przez okres niezbędny do ustalenia, dochodzenia lub obrony roszczeń. Logi techniczne są utrzymywane wyłącznie w zakresie i czasie potrzebnym do bezpieczeństwa oraz diagnostyki. Resend publikuje własne okresy retencji dla danych wiadomości i logów w dokumentacji GDPR.',
  },
  {
    title: 'Twoje prawa',
    body: 'W granicach wynikających z RODO możesz żądać dostępu do danych, ich sprostowania, usunięcia lub ograniczenia przetwarzania, a w odpowiednich przypadkach również przeniesienia danych. Możesz wnieść sprzeciw wobec przetwarzania opartego na prawnie uzasadnionym interesie oraz skargę do właściwego organu nadzorczego; w Polsce jest nim Prezes Urzędu Ochrony Danych Osobowych.',
  },
  {
    title: 'Brak profilowania i trackerów',
    body: 'Strona nie wykorzystuje analityki behawioralnej, pikseli reklamowych ani automatycznego profilowania osób korzystających z formularza. Dane z wiadomości nie są używane do zautomatyzowanego podejmowania decyzji wywołujących skutki prawne lub podobnie istotny wpływ.',
  },
] : [
  {
    title: 'Data controller',
    body: 'Arkadiusz Kamrowski is the controller of personal data submitted through the form. For data-related matters you can use the contact form on this website. The form is used only for correspondence connected with the message you initiate.',
  },
  {
    title: 'Data processed',
    body: 'The form processes your name, email address, optional organization, selected topic and message content. Basic technical data is also processed to protect the form from abuse, including the IP address, request origin and information necessary to enforce submission limits.',
  },
  {
    title: 'Purpose and legal basis',
    body: 'Data is used to receive your message, conduct correspondence and protect the service. The legal basis is the legitimate interest in handling correspondence and securing the service (GDPR Article 6(1)(f)); where the contact is intended to enter into or perform a contract, processing may rely on steps taken at your request before entering into a contract or performance of a contract (Article 6(1)(b)). The checkbox confirms that you have read this privacy information; it is not marketing consent.',
  },
  {
    title: 'Recipients and processors',
    body: 'Data may be processed by providers necessary to operate the website and email: the Resend transactional email service, hosting/infrastructure providers and the mailbox provider. Data is not sold or passed to advertising networks, a newsletter or an automated CRM.',
  },
  {
    title: 'Transfers outside the EEA',
    body: 'Resend states that its primary processing operations and customer-data storage take place in the United States. EEA transfers are covered by the Standard Contractual Clauses incorporated into Resend’s DPA and additionally by the EU–U.S. Data Privacy Framework. Current provider terms are available in Resend’s documentation.',
  },
  {
    title: 'Retention',
    body: 'The form application does not create its own submissions database. Messages remain in email systems only for the time needed to handle the correspondence and then for the period necessary to establish, exercise or defend legal claims. Technical logs are kept only to the extent and for the time needed for security and diagnostics. Resend publishes its own retention periods for message and log data in its GDPR documentation.',
  },
  {
    title: 'Your rights',
    body: 'Subject to the conditions in the GDPR, you may request access, rectification, erasure or restriction of processing and, where applicable, data portability. You may object to processing based on legitimate interests and lodge a complaint with the competent supervisory authority.',
  },
  {
    title: 'No profiling or advertising trackers',
    body: 'The site does not use behavioural analytics, advertising pixels or automated profiling of people using the form. Message data is not used for automated decision-making that produces legal effects or similarly significant effects.',
  },
];
const providerLinks = [
  { label: 'Resend GDPR', href: 'https://resend.com/security/gdpr' },
  { label: 'Resend DPA', href: 'https://resend.com/legal/dpa' },
];
---
<BaseLayout locale={locale} routeKey="privacy" title={td(p.title)} description={td(p.description)}>
  <PageHero eyebrow={td(p.eyebrow)} headline={td(p.headline)} lead={td(p.lead)} />
  <section class="section privacy-grid" aria-label={pl ? 'Informacje o prywatności' : 'Privacy information'}>
    {sections.map((item, index) => (
      <article><span>{String(index + 1).padStart(2, '0')}</span><h2>{td(item.title)}</h2><p>{td(item.body)}</p></article>
    ))}
  </section>
  <section class="section privacy-cta" aria-label={pl ? 'Dokumentacja dostawcy i kontakt' : 'Provider documentation and contact'}>
    <div class="privacy-provider-links">
      <p class="eyebrow">{pl ? 'Dokumentacja procesora' : 'Processor documentation'}</p>
      {providerLinks.map((link) => (
        <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>
      ))}
    </div>
    <a class="button button-primary" href={route(locale, 'contact')}>{editorial[locale].nav.contact}<span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
