---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { copy } from '../i18n/content';
import { privacyContent } from '../content/privacy';
import { editorial } from '../content/editorial';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = privacyContent[locale];
const c = copy[locale];
---
<BaseLayout locale={locale} routeKey="privacy" title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} headline={p.headline} lead={p.lead} />
  <section class="section privacy-grid" aria-label={locale === 'pl' ? 'Informacje o prywatności' : 'Privacy information'}>
    <p class="privacy-updated">{p.updated}</p>
    {p.sections.map((item, index) => (
      <article>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <h2>{item.title}</h2>
        <p>{item.body}</p>
        {item.href && item.linkLabel && (
          <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">
            {item.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only"> – {c.externalNewTab}</span>
          </a>
        )}
      </article>
    ))}
  </section>
  <section class="section privacy-cta">
    <a class="button button-primary" href={route(locale, 'contact')}>{editorial[locale].nav.contact}<span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
