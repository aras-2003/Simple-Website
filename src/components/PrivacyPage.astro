---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { privacySections, providerLinks } from '../content/privacy';
import { ui } from '../content/ui';
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = ui[locale].privacy;
const td = (value: string) => value.replaceAll('—', '–');
const pl = locale === 'pl';
const sections = privacySections[locale];
const privacyContactEmail = 'contact@arkadiuszkamrowski.com';
---
<BaseLayout locale={locale} routeKey="privacy" title={td(p.title)} description={td(p.description)}>
  <PageHero eyebrow={td(p.eyebrow)} headline={td(p.headline)} lead={td(p.lead)} />
  <section class="section privacy-grid" aria-label={pl ? 'Informacje o prywatności' : 'Privacy information'}>
    {sections.map((item, index) => (
      <article>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <h2>{td(item.title)}</h2>
        <p>{td(item.body)}</p>
        {index === 0 && (
          <a class="privacy-contact" href={`mailto:${privacyContactEmail}`}>
            <span class="privacy-contact-label">{pl ? 'Kontakt w sprawach danych' : 'Data privacy enquiries'}</span>
            <span class="privacy-contact-detail">
              <span class="privacy-contact-address">{privacyContactEmail}</span>
              <span class="privacy-contact-arrow" aria-hidden="true">↗</span>
            </span>
          </a>
        )}
      </article>
    ))}
  </section>
  <section class="section privacy-cta" aria-label={pl ? 'Dokumentacja dostawcy i kontakt' : 'Provider documentation and contact'}>
    <div class="privacy-provider-links">
      <p class="eyebrow">{pl ? 'Dokumentacja procesora' : 'Processor documentation'}</p>
      {providerLinks.map((link) => (
        <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>
      ))}
    </div>
    <a class="button button-primary" href={route(locale, 'contact')}>{ui[locale].nav.contact}<span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .privacy-contact {
    display: inline-flex;
    max-width: 100%;
    flex-direction: column;
    gap: .25rem;
    margin-top: 1.35rem;
    padding: .8rem 0 .35rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .privacy-contact-label {
    color: var(--green);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: .06em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .privacy-contact-detail {
    display: inline-flex;
    max-width: 100%;
    align-items: baseline;
    gap: .8rem;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }
  .privacy-contact-address { overflow-wrap: anywhere; }
  .privacy-contact-arrow {
    flex: none;
    font-size: 18px;
    font-weight: 400;
    transition: transform .15s ease;
  }
  .privacy-contact:hover .privacy-contact-address { text-decoration: underline; text-underline-offset: .2em; }
  .privacy-contact:hover .privacy-contact-arrow { transform: translate(2px, -2px); }
  @media (prefers-reduced-motion: reduce) {
    .privacy-contact-arrow { transition: none; }
    .privacy-contact:hover .privacy-contact-arrow { transform: none; }
  }
</style>
