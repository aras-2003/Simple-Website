---
import { copy } from '../i18n/content';
import type { Locale } from '../lib/site';

type BenchmarkItem = {
  value: string;
  title: string;
  body: string;
  source: string;
  href: string;
};

interface Props {
  locale: Locale;
  items: BenchmarkItem[];
}

const { locale, items } = Astro.props;
const c = copy[locale];
const pl = locale === 'pl';
---
<figure class="benchmark-signal-field" aria-labelledby="benchmark-field-caption">
  <div class="benchmark-signal-grid">
    {items.map((item, index) => (
      <article class="benchmark-signal">
        <div class="benchmark-signal-head">
          <span>{pl ? 'Sygnał' : 'Signal'} {String(index + 1).padStart(2, '0')}</span>
          <a href={item.href} target="_blank" rel="noopener noreferrer">
            {item.source}<span aria-hidden="true"> ↗</span><span class="sr-only"> – {c.externalNewTab}</span>
          </a>
        </div>
        <div class="benchmark-signal-divider" aria-hidden="true"></div>
        <p class="benchmark-signal-value">{item.value}</p>
        <h3>{item.title}</h3>
        <details class="benchmark-context">
          <summary>{pl ? 'Kontekst i znaczenie zarządcze' : 'Context and management meaning'}</summary>
          <p>{item.body}</p>
        </details>
      </article>
    ))}
  </div>
  <figcaption id="benchmark-field-caption">
    {pl
      ? 'Trzy niezależne benchmarki z różnych badań. Nie są bezpośrednio porównywalne — dlatego każda liczba jest pokazana jako osobny sygnał, a nie punkt na wspólnej skali.'
      : 'Three independent benchmarks from different studies. They are not directly comparable — each number is therefore shown as its own signal, not as a point on a shared scale.'}
  </figcaption>
</figure>