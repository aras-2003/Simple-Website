---
import { copy } from '../i18n/content';
import type { Locale } from '../lib/site';

type BenchmarkItem = {
  value: string;
  title: string;
  body: string;
  source: string;
  href: string;
};

interface Props {
  locale: Locale;
  items: BenchmarkItem[];
}

const { locale, items } = Astro.props;
const c = copy[locale];
const pl = locale === 'pl';
---
<figure class="benchmark-signal-field" aria-labelledby="benchmark-field-caption">
  <div class="benchmark-signal-grid">
    {items.map((item, index) => (
      <article class:list={['benchmark-signal', `benchmark-signal-${index + 1}`]}>
        <div class="benchmark-signal-head">
          <span>{pl ? 'Sygnał' : 'Signal'} {String(index + 1).padStart(2, '0')}</span>
          <a href={item.href} target="_blank" rel="noopener noreferrer">
            {item.source}<span aria-hidden="true"> ↗</span><span class="sr-only"> – {c.externalNewTab}</span>
          </a>
        </div>
        <div class="benchmark-signal-ruler" aria-hidden="true">
          <span class="benchmark-signal-fill"></span>
          <span class="benchmark-signal-marker"></span>
        </div>
        <p class="benchmark-signal-value">{item.value}</p>
        <h3>{item.title}</h3>
        <details class="benchmark-context">
          <summary>{pl ? 'Co ten sygnał mówi zarządczo' : 'What this signal means for management'}</summary>
          <p>{item.body}</p>
        </details>
      </article>
    ))}
  </div>
  <figcaption id="benchmark-field-caption">
    {pl
      ? 'Trzy niezależne benchmarki z różnych badań. Nie są bezpośrednio porównywalne — razem pokazują, że utrata wartości często pojawia się pomiędzy projektem zmiany a zdolnością organizacji do jej wykonania.'
      : 'Three independent benchmarks from different studies. They are not directly comparable — together they show how value is often lost between the design of change and the organization’s ability to execute it.'}
  </figcaption>
</figure>
