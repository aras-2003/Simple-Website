---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { editorial } from '../content/editorial';
import { writingSlug } from '../content/writing';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; note: CollectionEntry<'writing'>; }
const { locale, note } = Astro.props;
const ia = editorial[locale];
const data = note.data;
const slug = writingSlug(note);
const td = (value: string) => value.replaceAll('—', '–');
const title = `${td(data.title)} – Arkadiusz Kamrowski`;
const base = route(locale, 'writing');
const plPath = `${route('pl', 'writing')}/${slug}`;
const enPath = `${route('en', 'writing')}/${slug}`;
const publishedAt = data.publishedAt.toISOString();
const modifiedAt = (data.modifiedAt ?? data.publishedAt).toISOString();
const { Content } = await render(note);
---
<BaseLayout
  locale={locale}
  routeKey="writing"
  title={title}
  description={td(data.dek)}
  paths={{ pl: plPath, en: enPath }}
  contentType="article"
  publishedTime={publishedAt}
  modifiedTime={modifiedAt}
  articleSection={data.category}
>
  <article class="note-page note-page-editorial" itemscope itemtype="https://schema.org/Article">
    <meta itemprop="datePublished" content={publishedAt} />
    <meta itemprop="dateModified" content={modifiedAt} />
    <meta itemprop="articleSection" content={data.category} />
    <span itemprop="author" itemscope itemtype="https://schema.org/Person">
      <meta itemprop="name" content="Arkadiusz Kamrowski" />
    </span>

    <header class="note-hero">
      <p class="eyebrow">{data.category}</p>
      <h1 itemprop="headline">{td(data.title)}</h1>
      <p class="page-lead" itemprop="description">{td(data.dek)}</p>
      <div class="article-thesis-label">
        <span>Status</span>
        <strong>{locale === 'pl' ? 'teza robocza do konfrontowania z dowodami' : 'working thesis to be tested against evidence'}</strong>
      </div>
    </header>

    <div class="note-body note-body-markdown" itemprop="articleBody">
      <Content />
    </div>

    {data.sources.length > 0 && (
      <aside class="article-sources" aria-labelledby="article-sources-title">
        <p class="eyebrow">{locale === 'pl' ? 'Kontekst źródłowy' : 'Research context'}</p>
        <h2 id="article-sources-title">{locale === 'pl' ? 'Punkty odniesienia do dalszej weryfikacji' : 'Reference points for further verification'}</h2>
        <p>{locale === 'pl' ? 'Poniższe źródła nie są przypisem do każdego zdania. Pokazują literaturę i benchmarki, z którymi teza powinna być konfrontowana.' : 'These sources are not citations for every sentence. They show the literature and benchmarks against which the thesis should be tested.'}</p>
        <ul>{data.sources.map((source) => <li><a itemprop="citation" href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
      </aside>
    )}

    <footer class="note-footer note-footer-editorial">
      <a class="text-link" href={base}>← {ia.nav.writing}</a>
      <a class="button button-primary" href={route(locale, 'oaf')}>{locale === 'pl' ? 'Zobacz syntezę w OAF' : 'See the synthesis in OAF'}<span aria-hidden="true">→</span></a>
    </footer>
  </article>
</BaseLayout>
