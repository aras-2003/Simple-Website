---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { perspective, relatedEssays } from '../content/perspective';
import { journey } from '../content/journey';
import { getWriting } from '../content/writing';
import { writingSlug } from '../content/writing';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; note: CollectionEntry<'writing'>; }
const { locale, note } = Astro.props;
const x = perspective[locale];
const related = (await getWriting(locale)).find(item => writingSlug(item) === relatedEssays[writingSlug(note)]);
const data = note.data;
const slug = writingSlug(note);
const td = (value: string) => value.replaceAll('—', '–');
const title = `${td(data.title)} – Arkadiusz Kamrowski`;
const base = route(locale, 'writing');
const plPath = `${route('pl', 'writing')}/${slug}`;
const enPath = `${route('en', 'writing')}/${slug}`;
const publishedAt = data.publishedAt.toISOString();
const modifiedAt = (data.modifiedAt ?? data.publishedAt).toISOString();
const { Content } = await render(note);
---
<BaseLayout
  locale={locale}
  routeKey="writing"
  title={title}
  description={td(data.dek)}
  paths={{ pl: plPath, en: enPath }}
  contentType="article"
  publishedTime={publishedAt}
  modifiedTime={modifiedAt}
  articleSection={data.category}
>
  <article class="note-page note-page-editorial" itemscope itemtype="https://schema.org/Article">
    <meta itemprop="datePublished" content={publishedAt} />
    <meta itemprop="dateModified" content={modifiedAt} />
    <meta itemprop="articleSection" content={data.category} />
    <span itemprop="author" itemscope itemtype="https://schema.org/Person">
      <meta itemprop="name" content="Arkadiusz Kamrowski" />
    </span>

    <header class="note-hero">
      <p class="eyebrow">{data.category}</p>
      <h1 itemprop="headline">{td(data.title)}</h1>
      <p class="page-lead" itemprop="description">{td(data.dek)}</p>
      <p class="article-byline"><a href={route(locale,'about')}>Arkadiusz Kamrowski</a> · <time datetime={publishedAt}>{data.publishedAt.toLocaleDateString(locale === 'pl' ? 'pl-PL' : 'en-GB', {year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></p>
    </header>

    <div class="note-body note-body-markdown" itemprop="articleBody">
      <Content />
    </div>

    {data.sources.length > 0 && (
      <aside class="article-sources" aria-labelledby="article-sources-title">
        <h2 id="article-sources-title">{x.sources}</h2>
        <ul>{data.sources.map((source) => <li><a itemprop="citation" href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
      </aside>
    )}

    <footer class="note-footer note-footer-editorial">
      {related && <div><p class="eyebrow">{x.related}</p><a class="text-link" href={`${base}/${writingSlug(related)}`}>{related.data.title}<span aria-hidden="true">↗</span></a></div>}
      <div class="next-paths"><a class="text-link" href={route(locale,'work')}>{x.advisory}</a><a class="button button-primary" href={route(locale,'contact')}>{journey[locale].cta}<span aria-hidden="true">↗</span></a></div>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .note-body .evidence-callout {
    margin: clamp(2rem, 5vw, 3.5rem) 0;
    padding: 1.5rem 0 1.4rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .note-body .evidence-callout p {
    margin: 0;
  }

  .note-body .evidence-callout .evidence-number {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4.8rem);
    line-height: .95;
    letter-spacing: -.045em;
    color: var(--green);
  }

  .note-body .evidence-callout .evidence-copy {
    max-width: 46rem;
    margin-top: .8rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .note-body .evidence-callout .evidence-source {
    margin-top: .65rem;
    font-size: .8rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .note-body .evidence-callout a {
    color: inherit;
  }

  .note-body .concept-figure {
    width: min(58rem, calc(100vw - 4rem));
    max-width: none;
    margin: clamp(2.75rem, 6vw, 4.5rem) 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--white);
    border-top: 3px solid var(--green);
    box-shadow: 7px 7px 0 #e6e5db;
  }

  .note-body .concept-figure figcaption {
    display: grid;
    grid-template-columns: minmax(8rem, .7fr) minmax(0, 1.3fr);
    gap: 1.5rem 2rem;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .note-body .concept-kicker {
    font-size: .7rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .concept-figure figcaption strong {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.03em;
  }

  .note-body .concept-node {
    padding: 1rem 1.1rem;
    border-block: 1px solid var(--line);
    font-size: .86rem;
    line-height: 1.45;
    text-align: center;
  }

  .note-body .concept-node--primary {
    border-color: var(--green);
    font-weight: 700;
    color: var(--green);
  }

  .note-body .concept-arrow {
    padding: .45rem 0;
    font-size: 1.4rem;
    line-height: 1;
    text-align: center;
    color: var(--green);
  }

  .note-body .concept-branches {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .note-body .concept-branch {
    min-height: 8.2rem;
    padding: 1.15rem;
  }

  .note-body .concept-branch + .concept-branch {
    border-left: 1px solid var(--line);
  }

  .note-body .concept-branch span,
  .note-body .spectrum-level span,
  .note-body .adapt-step span {
    display: block;
    margin-bottom: .55rem;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--green);
  }

  .note-body .concept-branch strong,
  .note-body .spectrum-level strong,
  .note-body .adapt-step strong {
    display: block;
    font-size: .82rem;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .note-body .concept-branch small,
  .note-body .spectrum-level small,
  .note-body .adapt-step small {
    display: block;
    margin-top: .5rem;
    font-size: .76rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .note-body .concept-footer-line {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border-top: 1px solid var(--line);
  }

  .note-body .concept-footer-line span {
    padding: .9rem 1rem;
    font-size: .76rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .note-body .concept-footer-line span + span {
    border-left: 1px solid var(--line);
  }

  .note-body .decision-spectrum {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .note-body .spectrum-level {
    min-height: 9rem;
    padding: 1.15rem;
  }

  .note-body .spectrum-level + .spectrum-level {
    border-left: 1px solid var(--line);
  }

  .note-body .spectrum-axis {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: .85rem;
    font-size: .68rem;
    font-weight: 650;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .adaptation-sequence {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .note-body .adapt-step {
    position: relative;
    min-height: 7.4rem;
    padding: 1.05rem .85rem;
  }

  .note-body .adapt-step + .adapt-step {
    border-left: 1px solid var(--line);
  }

  .note-body .adapt-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -.48rem;
    top: 50%;
    z-index: 1;
    padding: 0 .12rem;
    background: var(--white);
    color: var(--green);
    transform: translateY(-50%);
  }

  .note-body .decision-branches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .note-body .decision-branches div {
    padding: 1rem;
  }

  .note-body .decision-branches div + div {
    border-left: 1px solid var(--line);
  }

  .note-body .decision-branches strong {
    display: block;
    font-size: .78rem;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .note-body .decision-branches span {
    display: block;
    margin-top: .35rem;
    font-size: .76rem;
    color: var(--muted);
  }

  .note-body .decision-trace {
    width: min(54rem, calc(100vw - 4rem));
    max-width: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 2rem 0 2.75rem;
    border-block: 1px solid var(--line);
  }

  .note-body .decision-trace span {
    position: relative;
    padding: .85rem .75rem;
    font-size: .68rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .06em;
    text-align: center;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .decision-trace span + span {
    border-left: 1px solid var(--line);
  }

  .note-body .exposure-grid {
    display: grid;
    gap: .8rem;
  }

  .note-body .exposure-row {
    display: grid;
    grid-template-columns: minmax(7rem, .7fr) auto minmax(10rem, 1.5fr) auto;
    gap: .8rem;
    align-items: center;
    font-size: .72rem;
  }

  .note-body .exposure-row strong {
    font-size: .82rem;
  }

  .note-body .exposure-row > span {
    color: var(--muted);
  }

  .note-body .exposure-track {
    position: relative;
    height: 1px;
    background: var(--line);
  }

  .note-body .exposure-track::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    transform: translate(50%, -50%);
  }

  .note-body .control-scale {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 1.5rem;
    border-top: 2px solid var(--green);
  }

  .note-body .control-scale span {
    padding: .85rem .5rem 0;
    font-size: .68rem;
    font-weight: 650;
    line-height: 1.35;
    text-align: center;
    color: var(--muted);
  }

  .note-body .control-scale span:last-child {
    color: var(--green);
  }

  .note-body .concept-note {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: .78rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .note-body .concept-figure,
    .note-body .decision-trace {
      width: 100%;
      box-shadow: 5px 5px 0 #e6e5db;
    }

    .note-body .concept-figure figcaption {
      grid-template-columns: 1fr;
      gap: .55rem;
    }

    .note-body .concept-branches,
    .note-body .decision-spectrum,
    .note-body .adaptation-sequence,
    .note-body .control-scale,
    .note-body .decision-trace {
      grid-template-columns: 1fr;
    }

    .note-body .concept-branch,
    .note-body .spectrum-level,
    .note-body .adapt-step {
      min-height: 0;
    }

    .note-body .concept-branch + .concept-branch,
    .note-body .spectrum-level + .spectrum-level,
    .note-body .adapt-step + .adapt-step,
    .note-body .decision-trace span + span {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .note-body .adapt-step:not(:last-child)::after {
      content: '↓';
      right: 1rem;
      top: auto;
      bottom: -.65rem;
      transform: none;
    }

    .note-body .spectrum-axis {
      display: block;
      line-height: 1.7;
    }

    .note-body .spectrum-axis span {
      display: block;
    }

    .note-body .exposure-row {
      grid-template-columns: 1fr auto;
      gap: .35rem .8rem;
    }

    .note-body .exposure-track {
      grid-column: 1 / -1;
      grid-row: 2;
      margin: .4rem .3rem .65rem 0;
    }

    .note-body .control-scale span {
      padding: .75rem 0;
      text-align: left;
    }
  }
</style>
