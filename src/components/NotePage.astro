---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { perspective, relatedEssays } from '../content/perspective';
import { journey } from '../content/journey';
import { getWriting } from '../content/writing';
import { writingSlug } from '../content/writing';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; note: CollectionEntry<'writing'>; }
const { locale, note } = Astro.props;
const x = perspective[locale];
const related = (await getWriting(locale)).find(item => writingSlug(item) === relatedEssays[writingSlug(note)]);
const data = note.data;
const slug = writingSlug(note);
const td = (value: string) => value.replaceAll('—', '–');
const title = `${td(data.title)} – Arkadiusz Kamrowski`;
const base = route(locale, 'writing');
const plPath = `${route('pl', 'writing')}/${slug}`;
const enPath = `${route('en', 'writing')}/${slug}`;
const publishedAt = data.publishedAt.toISOString();
const modifiedAt = (data.modifiedAt ?? data.publishedAt).toISOString();
const { Content } = await render(note);
---
<BaseLayout
  locale={locale}
  routeKey="writing"
  title={title}
  description={td(data.dek)}
  paths={{ pl: plPath, en: enPath }}
  contentType="article"
  publishedTime={publishedAt}
  modifiedTime={modifiedAt}
  articleSection={data.category}
>
  <article class="note-page note-page-editorial" itemscope itemtype="https://schema.org/Article">
    <meta itemprop="datePublished" content={publishedAt} />
    <meta itemprop="dateModified" content={modifiedAt} />
    <meta itemprop="articleSection" content={data.category} />
    <span itemprop="author" itemscope itemtype="https://schema.org/Person">
      <meta itemprop="name" content="Arkadiusz Kamrowski" />
    </span>

    <header class="note-hero">
      <p class="eyebrow">{data.category}</p>
      <h1 itemprop="headline">{td(data.title)}</h1>
      <p class="page-lead" itemprop="description">{td(data.dek)}</p>
      <p class="article-byline"><a href={route(locale,'about')}>Arkadiusz Kamrowski</a> · <time datetime={publishedAt}>{data.publishedAt.toLocaleDateString(locale === 'pl' ? 'pl-PL' : 'en-GB', {year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></p>
    </header>

    <div class="note-body note-body-markdown" itemprop="articleBody">
      <Content />
    </div>

    {data.sources.length > 0 && (
      <aside class="article-sources" aria-labelledby="article-sources-title">
        <h2 id="article-sources-title">{x.sources}</h2>
        <ul>{data.sources.map((source) => <li><a itemprop="citation" href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
      </aside>
    )}

    <footer class="note-footer note-footer-editorial">
      {related && <div><p class="eyebrow">{x.related}</p><a class="text-link" href={`${base}/${writingSlug(related)}`}>{related.data.title}<span aria-hidden="true">↗</span></a></div>}
      <div class="next-paths"><a class="text-link" href={route(locale,'work')}>{x.advisory}</a><a class="button button-primary" href={route(locale,'contact')}>{journey[locale].cta}<span aria-hidden="true">↗</span></a></div>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .note-body .evidence-callout {
    margin: clamp(2rem, 5vw, 3.5rem) 0;
    padding: 1.5rem 0 1.4rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .note-body .evidence-callout p { margin: 0; }

  .note-body .evidence-callout .evidence-number {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4.8rem);
    line-height: .95;
    letter-spacing: -.045em;
    color: var(--green);
  }

  .note-body .evidence-callout .evidence-copy {
    max-width: 46rem;
    margin-top: .8rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .note-body .evidence-callout .evidence-source {
    margin-top: .65rem;
    font-size: .8rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .note-body .evidence-callout a { color: inherit; }

  /* Minimal editorial diagrams: one idea, few labels, no UI chrome. */
  .note-body .concept-figure {
    width: min(54rem, calc(100vw - 4rem));
    max-width: none;
    margin: clamp(3rem, 7vw, 5rem) 0;
    padding: 1.6rem 0 1.8rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .note-body .concept-figure figcaption {
    display: grid;
    grid-template-columns: minmax(7rem, .5fr) minmax(0, 1.5fr);
    gap: .8rem 2.25rem;
    align-items: start;
    margin-bottom: 2.25rem;
  }

  .note-body .concept-kicker {
    padding-top: .2rem;
    font-size: .64rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .concept-figure figcaption strong {
    max-width: 34rem;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.9vw, 1.6rem);
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -.02em;
  }

  .note-body .concept-node {
    max-width: 30rem;
    margin-inline: auto;
    padding: .4rem 0;
    font-size: .82rem;
    line-height: 1.45;
    text-align: center;
  }

  .note-body .concept-node--primary {
    font-weight: 700;
    color: var(--green);
  }

  .note-body .concept-figure--portfolio .concept-node:not(.concept-node--primary),
  .note-body .concept-figure--portfolio .concept-node:not(.concept-node--primary) + .concept-arrow {
    display: none;
  }

  .note-body .concept-arrow {
    padding: .12rem 0;
    font-family: var(--serif);
    font-size: .95rem;
    line-height: 1;
    text-align: center;
    color: var(--green);
  }

  .note-body .concept-branches,
  .note-body .decision-spectrum,
  .note-body .adaptation-sequence {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.4rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .note-body .concept-branches { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .note-body .decision-spectrum { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .note-body .adaptation-sequence { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  .note-body .concept-branch,
  .note-body .spectrum-level,
  .note-body .adapt-step {
    position: relative;
    min-height: 0;
  }

  .note-body .concept-branch::before,
  .note-body .spectrum-level::before,
  .note-body .adapt-step::before {
    content: '';
    position: absolute;
    top: -1.63rem;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--green);
  }

  .note-body .concept-branch > span,
  .note-body .spectrum-level > span,
  .note-body .adapt-step > span,
  .note-body .concept-branch small,
  .note-body .spectrum-level small,
  .note-body .adapt-step small {
    display: none;
  }

  .note-body .concept-branch strong,
  .note-body .spectrum-level strong,
  .note-body .adapt-step strong {
    display: block;
    font-size: .8rem;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: .035em;
    text-transform: uppercase;
  }

  .note-body .concept-footer-line,
  .note-body .decision-branches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .note-body .concept-footer-line span,
  .note-body .decision-branches span {
    font-size: .72rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .note-body .decision-branches strong {
    display: block;
    margin-bottom: .3rem;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .spectrum-axis {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.35rem;
    padding-top: .8rem;
    border-top: 1px solid var(--line);
    font-size: .6rem;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .note-body .spectrum-axis span:last-child { color: var(--green); text-align: right; }

  .note-body .concept-figure--transformation .adapt-step:nth-child(2),
  .note-body .concept-figure--transformation .adapt-step:nth-child(6) {
    display: none;
  }

  .note-body .adapt-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -.9rem;
    top: .05rem;
    font-family: var(--serif);
    font-size: .85rem;
    color: var(--green);
  }

  .note-body .concept-figure--transformation .adapt-step:nth-child(5)::after { display: none; }

  .note-body .decision-trace { display: none; }

  .note-body .exposure-grid {
    display: grid;
    gap: .9rem;
  }

  .note-body .exposure-row {
    display: grid;
    grid-template-columns: minmax(6rem, .55fr) auto minmax(10rem, 1.7fr) auto;
    gap: .7rem;
    align-items: center;
    font-size: .68rem;
  }

  .note-body .exposure-row strong { font-size: .78rem; font-weight: 650; }
  .note-body .exposure-row > span { color: var(--muted); }

  .note-body .exposure-track {
    position: relative;
    height: 1px;
    background: var(--line);
  }

  .note-body .exposure-track::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--green);
    transform: translate(50%, -50%);
  }

  .note-body .control-scale {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.5rem;
    border-top: 1px solid var(--green);
  }

  .note-body .control-scale span:nth-child(2),
  .note-body .control-scale span:nth-child(4) { display: none; }

  .note-body .control-scale span {
    position: relative;
    padding: .75rem .35rem 0 0;
    font-size: .64rem;
    font-weight: 650;
    line-height: 1.35;
    color: var(--muted);
  }

  .note-body .control-scale span::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 1px;
    height: 7px;
    background: var(--green);
  }

  .note-body .control-scale span:last-child { color: var(--green); }

  .note-body .concept-note {
    max-width: 38rem;
    margin-top: 1.25rem;
    padding-top: .85rem;
    border-top: 1px solid var(--line);
    font-size: .72rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .note-body .concept-figure { width: 100%; margin-block: 2.8rem; }

    .note-body .concept-figure figcaption {
      grid-template-columns: 1fr;
      gap: .45rem;
      margin-bottom: 1.65rem;
    }

    .note-body .concept-kicker { padding-top: 0; }

    .note-body .concept-branches,
    .note-body .decision-spectrum,
    .note-body .adaptation-sequence,
    .note-body .control-scale {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 0;
      border-top: 0;
    }

    .note-body .concept-branch,
    .note-body .spectrum-level,
    .note-body .adapt-step,
    .note-body .control-scale span {
      padding: .72rem 0 .72rem 1rem;
      border-top: 1px solid var(--line);
    }

    .note-body .concept-branch::before,
    .note-body .spectrum-level::before,
    .note-body .adapt-step::before {
      top: 1rem;
      left: 0;
    }

    .note-body .adapt-step:not(:last-child)::after {
      content: '↓';
      right: .15rem;
      top: auto;
      bottom: -.35rem;
    }

    .note-body .concept-footer-line,
    .note-body .decision-branches {
      grid-template-columns: 1fr;
      gap: .6rem;
    }

    .note-body .spectrum-axis {
      display: block;
      line-height: 1.7;
    }

    .note-body .spectrum-axis span { display: block; text-align: left; }

    .note-body .exposure-row {
      grid-template-columns: 1fr auto;
      gap: .3rem .7rem;
    }

    .note-body .exposure-track {
      grid-column: 1 / -1;
      grid-row: 2;
      margin: .35rem .3rem .55rem 0;
    }

    .note-body .control-scale span::before {
      top: 50%;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      transform: translateY(-50%);
    }
  }
</style>