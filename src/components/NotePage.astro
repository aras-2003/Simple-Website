---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { perspective, relatedEssays } from '../content/perspective';
import { journey } from '../content/journey';
import { getWriting } from '../content/writing';
import { writingSlug } from '../content/writing';
import { route, type Locale } from '../lib/site';

interface Props { locale: Locale; note: CollectionEntry<'writing'>; }
const { locale, note } = Astro.props;
const x = perspective[locale];
const related = (await getWriting(locale)).find(item => writingSlug(item) === relatedEssays[writingSlug(note)]);
const data = note.data;
const slug = writingSlug(note);
const td = (value: string) => value.replaceAll('—', '–');
const title = `${td(data.title)} – Arkadiusz Kamrowski`;
const base = route(locale, 'writing');
const plPath = `${route('pl', 'writing')}/${slug}`;
const enPath = `${route('en', 'writing')}/${slug}`;
const publishedAt = data.publishedAt.toISOString();
const modifiedAt = (data.modifiedAt ?? data.publishedAt).toISOString();
const { Content } = await render(note);
---
<BaseLayout
  locale={locale}
  routeKey="writing"
  title={title}
  description={td(data.dek)}
  paths={{ pl: plPath, en: enPath }}
  contentType="article"
  publishedTime={publishedAt}
  modifiedTime={modifiedAt}
  articleSection={data.category}
>
  <article class="note-page note-page-editorial" itemscope itemtype="https://schema.org/Article">
    <meta itemprop="datePublished" content={publishedAt} />
    <meta itemprop="dateModified" content={modifiedAt} />
    <meta itemprop="articleSection" content={data.category} />
    <span itemprop="author" itemscope itemtype="https://schema.org/Person">
      <meta itemprop="name" content="Arkadiusz Kamrowski" />
    </span>

    <header class="note-hero">
      <p class="eyebrow">{data.category}</p>
      <h1 itemprop="headline">{td(data.title)}</h1>
      <p class="page-lead" itemprop="description">{td(data.dek)}</p>
      <p class="article-byline"><a href={route(locale,'about')}>Arkadiusz Kamrowski</a> · <time datetime={publishedAt}>{data.publishedAt.toLocaleDateString(locale === 'pl' ? 'pl-PL' : 'en-GB', {year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></p>
    </header>

    <div class="note-body note-body-markdown" itemprop="articleBody">
      <Content />
    </div>

    {data.sources.length > 0 && (
      <aside class="article-sources" aria-labelledby="article-sources-title">
        <h2 id="article-sources-title">{x.sources}</h2>
        <ul>{data.sources.map((source) => <li><a itemprop="citation" href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
      </aside>
    )}

    <footer class="note-footer note-footer-editorial">
      {related && <div><p class="eyebrow">{x.related}</p><a class="text-link" href={`${base}/${writingSlug(related)}`}>{related.data.title}<span aria-hidden="true">↗</span></a></div>}
      <div class="next-paths"><a class="text-link" href={route(locale,'work')}>{x.advisory}</a><a class="button button-primary" href={route(locale,'contact')}>{journey[locale].cta}<span aria-hidden="true">↗</span></a></div>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .note-body .evidence-callout {
    margin: clamp(2rem, 5vw, 3.5rem) 0;
    padding: 1.5rem 0 1.4rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .note-body .evidence-callout p { margin: 0; }

  .note-body .evidence-callout .evidence-number {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4.8rem);
    line-height: .95;
    letter-spacing: -.045em;
    color: var(--green);
  }

  .note-body .evidence-callout .evidence-copy {
    max-width: 46rem;
    margin-top: .8rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .note-body .evidence-callout .evidence-source {
    margin-top: .65rem;
    font-size: .8rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .note-body .evidence-callout a { color: inherit; }

  /* Editorial diagrams: print-like, quiet and structural rather than card-like. */
  .note-body .concept-figure {
    width: min(56rem, calc(100vw - 4rem));
    max-width: none;
    margin: clamp(3.25rem, 7vw, 5.25rem) 0;
    padding: clamp(1.6rem, 3.5vw, 2.3rem) 0 clamp(1.7rem, 3.5vw, 2.4rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .note-body .concept-figure figcaption {
    display: grid;
    grid-template-columns: minmax(7.5rem, .55fr) minmax(0, 1.45fr);
    gap: 1rem 2.5rem;
    align-items: start;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .note-body .concept-kicker {
    padding-top: .28rem;
    font-size: .66rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .concept-figure figcaption strong {
    max-width: 36rem;
    font-family: var(--serif);
    font-size: clamp(1.28rem, 2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -.025em;
  }

  .note-body .concept-node {
    max-width: 32rem;
    margin-inline: auto;
    padding: .55rem 0;
    font-size: .83rem;
    line-height: 1.5;
    text-align: center;
  }

  .note-body .concept-node--primary {
    font-weight: 700;
    letter-spacing: .02em;
    color: var(--green);
  }

  .note-body .concept-arrow {
    padding: .15rem 0;
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1;
    text-align: center;
    color: var(--green);
  }

  .note-body .concept-branches {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: .35rem;
    padding-top: 1.45rem;
    border-top: 1px solid var(--line);
  }

  .note-body .concept-branch,
  .note-body .spectrum-level,
  .note-body .adapt-step {
    position: relative;
    min-height: 0;
  }

  .note-body .concept-branch::before,
  .note-body .spectrum-level::before {
    content: '';
    position: absolute;
    top: -1.68rem;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
  }

  .note-body .concept-branch span,
  .note-body .spectrum-level span,
  .note-body .adapt-step span {
    display: block;
    margin-bottom: .45rem;
    font-size: .64rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: .1em;
    color: var(--green);
  }

  .note-body .concept-branch strong,
  .note-body .spectrum-level strong,
  .note-body .adapt-step strong {
    display: block;
    font-size: .84rem;
    line-height: 1.4;
    letter-spacing: .025em;
    text-transform: uppercase;
  }

  .note-body .concept-branch small,
  .note-body .spectrum-level small,
  .note-body .adapt-step small {
    display: block;
    margin-top: .5rem;
    font-size: .76rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .note-body .concept-footer-line {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 1.6rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .note-body .concept-footer-line span {
    font-size: .74rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .note-body .decision-spectrum {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    padding-top: 1.55rem;
    border-top: 1px solid var(--line);
  }

  .note-body .spectrum-level { padding-right: .45rem; }

  .note-body .spectrum-axis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.65rem;
    padding-top: .9rem;
    border-top: 1px solid var(--line);
    font-size: .62rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .note-body .spectrum-axis span:nth-child(2) { text-align: center; }
  .note-body .spectrum-axis span:last-child { text-align: right; color: var(--green); }

  .note-body .adaptation-sequence {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(.8rem, 2vw, 1.4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .note-body .adapt-step { padding-right: .55rem; }

  .note-body .adapt-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -.7rem;
    top: 1.15rem;
    font-family: var(--serif);
    font-size: .9rem;
    color: var(--green);
  }

  .note-body .decision-branches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 1.7rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .note-body .decision-branches div { padding: 0; }

  .note-body .decision-branches strong {
    display: block;
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .decision-branches span {
    display: block;
    margin-top: .4rem;
    font-size: .75rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .note-body .decision-trace {
    width: min(52rem, calc(100vw - 4rem));
    max-width: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.8rem);
    margin: 2.25rem 0 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .note-body .decision-trace span {
    position: relative;
    padding-top: .35rem;
    font-size: .64rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .07em;
    text-align: left;
    text-transform: uppercase;
    color: var(--green);
  }

  .note-body .decision-trace span::before {
    content: '';
    position: absolute;
    top: -1.43rem;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
  }

  .note-body .exposure-grid {
    display: grid;
    gap: 1rem;
  }

  .note-body .exposure-row {
    display: grid;
    grid-template-columns: minmax(6.5rem, .6fr) auto minmax(10rem, 1.7fr) auto;
    gap: .8rem;
    align-items: center;
    font-size: .7rem;
  }

  .note-body .exposure-row strong { font-size: .8rem; font-weight: 650; }
  .note-body .exposure-row > span { color: var(--muted); }

  .note-body .exposure-track {
    position: relative;
    height: 1px;
    background: var(--line);
  }

  .note-body .exposure-track::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
    transform: translate(50%, -50%);
  }

  .note-body .control-scale {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 1.7rem;
    border-top: 1px solid var(--green);
  }

  .note-body .control-scale span {
    position: relative;
    padding: .85rem .4rem 0 0;
    font-size: .64rem;
    font-weight: 650;
    line-height: 1.4;
    text-align: left;
    color: var(--muted);
  }

  .note-body .control-scale span::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 1px;
    height: 7px;
    background: var(--green);
  }

  .note-body .control-scale span:last-child { color: var(--green); }

  .note-body .concept-note {
    max-width: 42rem;
    margin-top: 1.45rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: .75rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .note-body .concept-figure,
    .note-body .decision-trace { width: 100%; }

    .note-body .concept-figure {
      margin-block: 3rem;
      padding-block: 1.35rem 1.5rem;
    }

    .note-body .concept-figure figcaption {
      grid-template-columns: 1fr;
      gap: .55rem;
      margin-bottom: 1.8rem;
    }

    .note-body .concept-kicker { padding-top: 0; }

    .note-body .concept-branches,
    .note-body .decision-spectrum,
    .note-body .adaptation-sequence,
    .note-body .control-scale,
    .note-body .decision-trace {
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 0;
      padding-top: 0;
    }

    .note-body .concept-branch,
    .note-body .spectrum-level,
    .note-body .adapt-step,
    .note-body .decision-trace span,
    .note-body .control-scale span {
      padding: .8rem 0 .8rem 1.15rem;
      border-top: 1px solid var(--line);
    }

    .note-body .concept-branch::before,
    .note-body .spectrum-level::before,
    .note-body .decision-trace span::before {
      top: 1.15rem;
      left: 0;
    }

    .note-body .adapt-step:not(:last-child)::after {
      content: '↓';
      right: .2rem;
      top: auto;
      bottom: -.42rem;
      font-size: .8rem;
    }

    .note-body .concept-footer-line,
    .note-body .decision-branches {
      grid-template-columns: 1fr;
      gap: .8rem;
    }

    .note-body .spectrum-axis {
      display: block;
      margin-top: 1rem;
      font-size: .6rem;
      line-height: 1.7;
    }

    .note-body .spectrum-axis span,
    .note-body .spectrum-axis span:nth-child(2),
    .note-body .spectrum-axis span:last-child {
      display: block;
      text-align: left;
    }

    .note-body .decision-trace { margin-block: 2rem 2.6rem; }

    .note-body .exposure-row {
      grid-template-columns: 1fr auto;
      gap: .35rem .8rem;
    }

    .note-body .exposure-track {
      grid-column: 1 / -1;
      grid-row: 2;
      margin: .4rem .3rem .65rem 0;
    }

    .note-body .control-scale span::before {
      top: 50%;
      left: 0;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      transform: translateY(-50%);
    }
  }
</style>