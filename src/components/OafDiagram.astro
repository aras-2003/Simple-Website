---
import type { Locale } from '../lib/site';

interface Props { locale: Locale; id: string; compact?: boolean; }
const { locale, id, compact = false } = Astro.props;
const pl = locale === 'pl';
const labels = pl
  ? [
      { title: 'Kierunek', meta: 'strategia' },
      { title: 'Architektura', meta: 'wybory' },
      { title: 'Priorytety', meta: 'portfel' },
      { title: 'Dowody', meta: 'wykonanie' },
    ]
  : [
      { title: 'Direction', meta: 'strategy' },
      { title: 'Architecture', meta: 'choices' },
      { title: 'Priorities', meta: 'portfolio' },
      { title: 'Evidence', meta: 'execution' },
    ];
const centerTitle = pl ? 'Spójność decyzji' : 'Decision coherence';
const centerBody = pl
  ? 'Jedna logika łączy kierunek, wybory architektoniczne, finansowanie i dowód z wykonania.'
  : 'One logic connects direction, architectural choices, funding and execution evidence.';
const caption = pl
  ? 'OAF nie jest orbitą ani kolejną warstwą governance. To prosty kontrakt: każda kolejna decyzja musi być zgodna z poprzednią, a dowód z wykonania może zmienić założenie.'
  : 'OAF is not an orbit or another governance layer. It is a simple contract: each decision must cohere with the previous one, while execution evidence can change an assumption.';
---
<figure class:list={['oaf-system', { 'oaf-system-compact': compact }]} aria-labelledby={id}>
  <p class="sr-only" id={id}>{pl ? 'OAF — cztery obszary połączone w zamkniętą pętlę decyzji' : 'OAF — four domains connected in a closed decision loop'}</p>

  <div class="oaf-system-center">
    <span>OAF / {pl ? 'pętla decyzji' : 'decision loop'}</span>
    <strong>{centerTitle}</strong>
    {!compact && <p>{centerBody}</p>}
  </div>

  <ol class="oaf-system-flow">
    {labels.map((item, index) => (
      <li class="oaf-system-node">
        <span>{String(index + 1).padStart(2, '0')} · {item.meta}</span>
        <strong>{item.title}</strong>
      </li>
    ))}
  </ol>

  <div class="oaf-system-feedback">
    <span class="oaf-feedback-from">04 · {pl ? 'Dowody' : 'Evidence'}</span>
    <span class="oaf-feedback-arrow" aria-hidden="true">↺</span>
    <span class="oaf-feedback-to">01 · {pl ? 'Kierunek' : 'Direction'}</span>
    <small>{pl ? 'dowód zmienia kolejną decyzję, nie tylko raportuje wykonanie' : 'evidence changes the next decision, not just the execution report'}</small>
  </div>

  {!compact && <figcaption>{caption}</figcaption>}
</figure>
