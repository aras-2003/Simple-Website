---
import type { Locale } from '../lib/site';

interface Props { locale: Locale; id: string; compact?: boolean; }
const { locale, id, compact = false } = Astro.props;
const labels = locale === 'pl'
  ? {
      direction: { title: 'Kierunek', meta: 'strategia' },
      architecture: { title: 'Architektura', meta: 'wybory' },
      priorities: { title: 'Priorytety', meta: 'portfel' },
      evidence: { title: 'Dowody', meta: 'wykonanie' },
    }
  : {
      direction: { title: 'Direction', meta: 'strategy' },
      architecture: { title: 'Architecture', meta: 'choices' },
      priorities: { title: 'Priorities', meta: 'portfolio' },
      evidence: { title: 'Evidence', meta: 'execution' },
    };
const centerTitle = locale === 'pl' ? 'Spójność decyzji' : 'Decision coherence';
const centerBody = locale === 'pl'
  ? 'Punkt ciężkości leży w jakości połączeń i w tym, czy dowód może zmienić wcześniejsze założenie.'
  : 'The center of gravity is the quality of the connections and whether evidence can change an earlier assumption.';
const caption = locale === 'pl'
  ? 'OAF utrzymuje jedną pętlę pomiędzy kierunkiem, architekturą, priorytetami i dowodami z wykonania. Dowód nie kończy cyklu — wraca do kolejnej decyzji.'
  : 'OAF keeps one loop across direction, architecture, priorities and execution evidence. Evidence does not close the cycle — it feeds the next decision.';
---
<figure class:list={['oaf-system', { 'oaf-system-compact': compact }]} aria-labelledby={id}>
  <p class="sr-only" id={id}>{locale === 'pl' ? 'OAF — cztery współzależne obszary architektury organizacyjnej połączone pętlą informacji zwrotnej' : 'OAF — four interdependent organizational architecture domains connected by a feedback loop'}</p>

  <div class="oaf-system-canvas">
    <svg class="oaf-system-connectors" viewBox="0 0 100 100" aria-hidden="true" focusable="false" preserveAspectRatio="none">
      <path d="M50 24 L50 39" />
      <path d="M61 50 L76 50" />
      <path d="M50 61 L50 76" />
      <path d="M39 50 L24 50" />
      <path class="oaf-feedback-path" d="M18 42 C8 18, 27 8, 44 14" />
    </svg>

    <div class="oaf-system-node oaf-system-direction">
      <span>{labels.direction.meta}</span>
      <strong>{labels.direction.title}</strong>
    </div>
    <div class="oaf-system-node oaf-system-architecture">
      <span>{labels.architecture.meta}</span>
      <strong>{labels.architecture.title}</strong>
    </div>
    <div class="oaf-system-node oaf-system-priorities">
      <span>{labels.priorities.meta}</span>
      <strong>{labels.priorities.title}</strong>
    </div>
    <div class="oaf-system-node oaf-system-evidence">
      <span>{labels.evidence.meta}</span>
      <strong>{labels.evidence.title}</strong>
    </div>

    <div class="oaf-system-center">
      <span>OAF</span>
      <strong>{centerTitle}</strong>
      {!compact && <p>{centerBody}</p>}
    </div>

    <div class="oaf-system-feedback" aria-hidden="true">
      <span>↺</span>
      <small>{locale === 'pl' ? 'dowód → kolejna decyzja' : 'evidence → next decision'}</small>
    </div>
  </div>

  {!compact && <figcaption>{caption}</figcaption>}
</figure>